def _fmt_age(age) -> str:
    if age is None:
        return ""
    age = int(age)
    if age >= 3600:
        return f"{age // 3600}h {age % 3600 // 60:02d}m"
    return f"{age // 60}m {age % 60:02d}s"


def _parse_env_text(text: str) -> dict:
    env = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line or not line.split("=", 1)[0].strip():
            raise Error(f"bad environment line: {line}")
        k, v = line.split("=", 1)
        env[k.strip()] = v.strip()
    return env


def _gui_classes(Gtk, GLib, Gio, Pango, Gdk):
    """Build the GTK 3 classes (done lazily so the CLI never needs PyGObject)."""

    def dim(widget):
        widget.get_style_context().add_class("dim-label")
        return widget

    def install_status_css():
        """Green/amber status dots taken from the active theme's palette when it defines one."""
        provider = Gtk.CssProvider()
        try:
            provider.load_from_data(b".mm-running { color: @success_color; } "
                                    b".mm-starting { color: @warning_color; }")
        except GLib.Error:
            provider.load_from_data(b".mm-running { color: #26a269; } "
                                    b".mm-starting { color: #e5a50a; }")
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def icon_or_text(names, fallback):
        """First icon the current theme actually has, else a text label (never a broken image)."""
        theme = Gtk.IconTheme.get_default()
        for name in names:
            if theme.lookup_icon(name, 16, 0) is not None:
                return Gtk.Image.new_from_icon_name(name, Gtk.IconSize.BUTTON)
        return Gtk.Label(label=fallback)

    def make_popover(items):
        """items: [(text, callback) | None]; None is a separator. Standard GTK 3 popover menu."""
        pop = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_border_width(6)
        for item in items:
            if item is None:
                box.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL),
                               False, False, 4)
                continue
            text, callback = item
            btn = Gtk.ModelButton()
            btn.set_property("text", text)
            btn.connect("clicked", lambda _b, cb=callback: (pop.popdown(), cb()))
            box.pack_start(btn, False, False, 0)
        box.show_all()
        pop.add(box)
        return pop

    def icon_menu_button(icon, items, tooltip):
        btn = Gtk.MenuButton()
        btn.add(icon_or_text(icon, "\u22ee" if "more" in icon[0] else "\u2261"))
        btn.set_popover(make_popover(items))
        btn.set_tooltip_text(tooltip)
        return btn

    def version_combo(default_text=None):
        combo = Gtk.ComboBoxText.new_with_entry()
        have = list(cached())[::-1]
        for v in have:
            combo.append_text(v)
        if DEFAULT_VERSION not in have:
            combo.append_text(DEFAULT_VERSION)
        if have:
            combo.set_active(0)
        else:
            combo.get_child().set_text(default_text or DEFAULT_VERSION)
        return combo

    class VersionDialog(Gtk.Dialog):
        """Pick an AppImage version (or 'latest'); downloaded on demand."""

        def __init__(self, parent, title, accept):
            super().__init__(title=title, transient_for=parent, modal=True, use_header_bar=True)
            self.add_button("Cancel", Gtk.ResponseType.CANCEL)
            ok = self.add_button(accept, Gtk.ResponseType.OK)
            ok.get_style_context().add_class("suggested-action")
            self.set_default_response(Gtk.ResponseType.OK)
            area = self.get_content_area()
            area.set_border_width(16)
            area.set_spacing(10)
            self.combo = version_combo()
            self.combo.get_child().set_activates_default(True)
            self.latest = Gtk.CheckButton(label="Use the latest GitHub release instead")
            self.hint = dim(Gtk.Label(xalign=0))
            area.pack_start(Gtk.Label(label="Mocktail version", xalign=0), False, False, 0)
            area.pack_start(self.combo, False, False, 0)
            area.pack_start(self.latest, False, False, 0)
            area.pack_start(self.hint, False, False, 0)
            self.combo.connect("changed", lambda *_: self.update_hint())
            self.latest.connect("toggled", lambda *_: self.update_hint())
            self.update_hint()
            area.show_all()

        def text(self):
            return (self.combo.get_active_text() or "").strip()

        def update_hint(self):
            self.combo.set_sensitive(not self.latest.get_active())
            if self.latest.get_active():
                self.hint.set_text("Asks GitHub which release is newest.")
            elif self.text() in cached():
                self.hint.set_text("Already downloaded.")
            else:
                self.hint.set_text("Will be downloaded from GitHub (~160 MB).")

        def result(self):
            return (self.text() or None), self.latest.get_active()

    class InstanceRow(Gtk.ListBoxRow):
        def __init__(self, win, name):
