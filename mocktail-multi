            for w in (self.toggle, logs, self.menu):
                box.pack_start(w, False, False, 0)
            self.add(box)
            self.show_all()
            self._dot_class = None

        def update(self, inst, busy):
            label, pid, age = inst.status()
            cls = {"running": "mm-running", "starting": "mm-starting"}.get(label, "dim-label")
            ctx = self.dot.get_style_context()
            if cls != self._dot_class:
                if self._dot_class:
                    ctx.remove_class(self._dot_class)
                ctx.add_class(cls)
                self._dot_class = cls
            bits = [f"Mocktail {inst.version}", label]
            if pid:
                bits.append(f"pid {pid}")
            if label != "stopped" and age is not None:
                bits.append(f"up {_fmt_age(age)}")
            self.sub.set_text(" \u00b7 ".join(bits))
            self.toggle.set_label("Stop" if label != "stopped" else "Start")
            sc = self.toggle.get_style_context()
            if label == "stopped":
                sc.add_class("suggested-action")
            else:
                sc.remove_class("suggested-action")
            self.toggle.set_sensitive(not busy)
            self.menu.set_sensitive(not busy)
            return label

    class LogWindow(Gtk.Window):
        def __init__(self, parent, inst):
            super().__init__(title=f"Log \u2014 {inst.name}", transient_for=parent)
            self.inst, self.last, self.alive = inst, None, True
            self.set_default_size(780, 500)
            self.set_destroy_with_parent(True)
