def cmd_desktop(_args=None):
    """Install a launcher entry so the GUI shows up in app menus / rofi / wofi."""
    apps = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "applications"
    apps.mkdir(parents=True, exist_ok=True)
    script = os.path.abspath(__file__)
    target = apps / "mocktail-multi.desktop"
    target.write_text(
        "[Desktop Entry]\nType=Application\nName=Mocktail Multi\n"
        "Comment=Run several Mocktail (Roblox) instances\n"
        f'Exec=python3 "{script}" gui\nIcon=applications-games\n'
        "Terminal=false\nCategories=Game;\n")
    print(f"wrote {target}")


# ------------------------------------------------------------------------- main

def build_parser():
    p = argparse.ArgumentParser(
        prog="mocktail-multi",
        description="Run several Mocktail (Roblox on Linux) instances side by side. "
                    "With no command, opens the GUI (or the TUI without a display).")
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    sub.add_parser("gui", help="graphical interface (GTK 3) - default when a display is available")
    sub.add_parser("tui", help="interactive terminal UI")
    sub.add_parser("desktop-entry", help="install a launcher entry for the GUI in your app menu")

    s = sub.add_parser("fetch", help=f"download a Mocktail AppImage (default {DEFAULT_VERSION})")
    s.add_argument("-v", "--version", help="release tag, e.g. 1.0.4")
    s.add_argument("--latest", action="store_true", help="newest non-prerelease release")
    s.add_argument("-f", "--force", action="store_true", help="re-download even if cached")

    s = sub.add_parser("new", aliases=["add"], help="create instance(s)")
    s.add_argument("names", nargs="+", metavar="NAME")
    s.add_argument("-v", "--version", help="AppImage version to use (default: newest downloaded)")
    s.add_argument("-e", "--env", action="append", metavar="KEY=VALUE",
                   help="extra environment variable for this instance (repeatable)")
    s.add_argument("--seed", action="store_true",
                   help="copy the Roblox payload from an existing stopped instance (best-effort)")
    s.add_argument("--seed-from", metavar="NAME", help="like --seed, from a specific instance")

    for name, aliases, hlp in (("start", [], "start instance(s)"),
                               ("stop", [], "stop instance(s)"),
                               ("restart", [], "restart instance(s)"),
                               ("upgrade", [], "swap in a newer AppImage (instance must be stopped)")):
        s = sub.add_parser(name, aliases=aliases, help=hlp)
        s.add_argument("names", nargs="*", metavar="NAME")
        s.add_argument("-a", "--all", action="store_true", help="all instances")
        if name == "upgrade":
            s.add_argument("-v", "--version", help="version to use (downloaded if needed)")
            s.add_argument("--latest", action="store_true", help="use the newest release")

    s = sub.add_parser("list", aliases=["ls"], help="show instances and their status")
    s = sub.add_parser("rm", aliases=["delete"], help="delete instance(s) and their data")
    s.add_argument("names", nargs="+", metavar="NAME")
    s.add_argument("-y", "--yes", action="store_true", help="don't ask")
    s = sub.add_parser("logs", help="show an instance's console log")
    s.add_argument("name")
    s.add_argument("-n", "--lines", type=int, default=40)
    s.add_argument("-f", "--follow", action="store_true")
    s = sub.add_parser("path", help="print an instance's directory")
    s.add_argument("name")
    return p


COMMANDS = {
    "gui": cmd_gui, "desktop-entry": cmd_desktop, "tui": cmd_tui, "fetch": cmd_fetch, "new": cmd_new, "add": cmd_new,
    "start": cmd_start, "stop": cmd_stop, "restart": cmd_restart, "upgrade": cmd_upgrade,
    "list": cmd_list, "ls": cmd_list, "rm": cmd_rm, "delete": cmd_rm,
    "logs": cmd_logs, "path": cmd_path,
}


def _default_command() -> str:
    import importlib.util
    if (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) \
            and importlib.util.find_spec("gi") is not None:
        return "gui"
    return "tui" if sys.stdin.isatty() and sys.stdout.isatty() else "list"


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    cmd = args.cmd or _default_command()
    try:
        return COMMANDS[cmd](args) or 0
    except Error as e:
        print(paint(f"error: {e}", "31"), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print()
        return 130


if __name__ == "__main__":
    sys.exit(main())
