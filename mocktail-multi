        @staticmethod
        def _header(row, before):
            if before is not None and row.get_header() is None:
                row.set_header(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

        # ---- periodic refresh
        def tick(self):
            try:
                for name, code in reap():
                    if code != 0 and not Instance(name).running():
                        tail = "\n".join(tail_lines(Instance(name).log, 30))
                        hint = failure_hint(tail)
                        self.notify(f"{name} exited with code {code}." + (f"\n{hint}" if hint else ""),
                                    error=True, button=("View log", lambda n=name: self.show_log(n)))
                insts = list_instances()
                names = {i.name for i in insts}
                for n in list(self.rows):
                    if n not in names:
                        self.listbox.remove(self.rows.pop(n))
                running = 0
                for inst in insts:
                    row = self.rows.get(inst.name)
                    if row is None:
                        row = self.rows[inst.name] = InstanceRow(self, inst.name)
                        self.listbox.add(row)
                    if row.update(inst, inst.name in self.busy) != "stopped":
                        running += 1
                self.hb.set_subtitle(f"{running} running \u00b7 {len(insts)} instance"
                                     f"{'' if len(insts) == 1 else 's'}" if insts else "")
            except Exception:
                import traceback
                traceback.print_exc()
            return True

        def pulse(self):
            if self.jobs > 0 and not self.have_progress:
                self.pbar.pulse()
            return True

        # ---- notifications
        def notify(self, text, error=False, button=None, secs=6):
            bar = Gtk.InfoBar()
            bar.set_message_type(Gtk.MessageType.ERROR if error else Gtk.MessageType.INFO)
            bar.set_show_close_button(True)
            label = Gtk.Label(label=text[:700], xalign=0)
            label.set_line_wrap(True)
            label.set_selectable(True)
            bar.get_content_area().add(label)
            if button:
                bar.add_button(button[0], 1)
            bar.connect("response", lambda _b, resp, cb=(button[1] if button else None): (
                cb() if (cb and resp == 1) else None, bar.destroy()))
            self.bars.pack_start(bar, False, False, 0)
            bar.show_all()
            kids = self.bars.get_children()
            for old in kids[:-3]:
                old.destroy()
            if not error:
                GLib.timeout_add_seconds(secs, lambda: (bar.destroy() if bar.get_parent() else None, False)[1])

        # ---- background jobs
        def run_job(self, label, fn, busy=()):
            self.jobs += 1
            self.have_progress = False
            self.busy.update(busy)
            self.plabel.set_text(label + "\u2026")
            self.pbar.set_fraction(0)
            self.rev.set_reveal_child(True)
            last = [0.0]

            def on_progress(done, total):
                if total:
                    self.have_progress = True
                    self.pbar.set_fraction(min(1.0, done / total))
                    self.plabel.set_text(f"{label}  {human(done)} / {human(total)}")
                return False

            def progress(done, total):
                now = time.time()
                if now - last[0] > 0.1 or (total and done >= total):
                    last[0] = now
                    GLib.idle_add(on_progress, done, total)

            def finished(result, error):
                self.jobs -= 1
                self.busy.difference_update(busy)
                if self.jobs <= 0:
                    self.jobs = 0
                    self.rev.set_reveal_child(False)
                if error:
                    self.notify(error, error=True)
                elif result:
                    self.notify(result)
                self.tick()
                return False

            def worker():
                result = error = None
                try:
                    result = fn(progress)
                except Error as e:
                    error = str(e)
                except Exception as e:
                    error = f"{type(e).__name__}: {e}"
                GLib.idle_add(finished, result, error)

            threading.Thread(target=worker, daemon=True).start()
            self.tick()

        # ---- actions
        def toggle(self, name):
            inst = Instance(name)
            if inst.running():
                self.run_job(f"Stopping {name}", lambda p: stop(inst) and f"Stopped {name}",
                             busy=(name,))
                return
            try:
                start(inst)
            except Error as e:
                self.notify(str(e), error=True)
            self.tick()

        def start_all(self):
            todo = [i for i in list_instances() if not i.running()]
            if not todo:
                self.notify("Everything is already running.")
                return

            def work(_p):
                for i in todo:
                    start(i)
                    time.sleep(1.0)
                return f"Started {len(todo)} instance(s)"
            self.run_job("Starting all", work, busy=[i.name for i in todo])

        def stop_all(self):
            todo = [i for i in list_instances() if i.running()]
            if not todo:
                self.notify("Nothing is running.")
                return

            def work(_p):
                for i in todo:
                    stop(i)
                return f"Stopped {len(todo)} instance(s)"
            self.run_job("Stopping all", work, busy=[i.name for i in todo])

        def show_log(self, name):
            existing = self.logwins.get(name)
            if existing:
                existing.present()
                return
            win = self.logwins[name] = LogWindow(self, Instance(name))
            win.connect("destroy", lambda *_: self.logwins.pop(name, None))

        def open_folder(self, path):
            path = Path(path)
            path.mkdir(parents=True, exist_ok=True)
            try:
                Gio.AppInfo.launch_default_for_uri(path.as_uri(), None)
            except GLib.Error as e:
                self.notify(f"Could not open {path}: {e.message}", error=True)

        def fetch_dialog(self):
            dlg = VersionDialog(self, "Download AppImage", "Download")
            resp = dlg.run()
            version, latest = dlg.result()
            dlg.destroy()
            if resp != Gtk.ResponseType.OK:
                return

            def work(p):
                ver, _path, sha = fetch(version, latest=latest, progress=p)
                return f"Downloaded Mocktail {ver}" if sha else f"Mocktail {ver} is already downloaded"
            self.run_job("Downloading AppImage", work)

        def upgrade_dialog(self, name):
            inst = Instance(name)
            if inst.running():
                self.notify(f"Stop {name} before upgrading it.", error=True)
                return
            dlg = VersionDialog(self, f"Upgrade {name}", "Upgrade")
            resp = dlg.run()
            version, latest = dlg.result()
            dlg.destroy()
            if resp != Gtk.ResponseType.OK:
                return
            self.run_job(f"Upgrading {name}", lambda p: "{} is now on Mocktail {}".format(
                name, upgrade_instance(inst, version=version, latest=latest, progress=p)),
                busy=(name,))

        def delete_dialog(self, name):
            inst = Instance(name)
            if inst.running():
                self.notify(f"Stop {name} before deleting it.", error=True)
                return
            dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                    message_type=Gtk.MessageType.WARNING,
                                    text=f"Delete \u201c{name}\u201d?")
            dlg.format_secondary_text(
                "This removes its login session, settings and downloaded Roblox data. "
                "It can't be undone.")
            dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
            btn = dlg.add_button("Delete", Gtk.ResponseType.OK)
            btn.get_style_context().add_class("destructive-action")
            resp = dlg.run()
            dlg.destroy()
            if resp == Gtk.ResponseType.OK:
                self.run_job(f"Deleting {name}",
                             lambda p: (rmtree_force(inst.dir), f"Deleted {name}")[1],
                             busy=(name,))

        def new_dialog(self):
            dlg = Gtk.Dialog(title="New instance", transient_for=self, modal=True,
                             use_header_bar=True)
            dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
            ok = dlg.add_button("Create", Gtk.ResponseType.OK)
            ok.get_style_context().add_class("suggested-action")
            dlg.set_default_response(Gtk.ResponseType.OK)
            area = dlg.get_content_area()
            area.set_border_width(16)
            area.set_spacing(10)

            grid = Gtk.Grid()
            grid.set_row_spacing(8)
            grid.set_column_spacing(12)
            name_entry = Gtk.Entry()
            name_entry.set_hexpand(True)
            name_entry.set_activates_default(True)
            name_entry.set_placeholder_text("acc1   (or several: acc1, acc2, acc3)")
            combo = version_combo()
            grid.attach(Gtk.Label(label="Name", xalign=1), 0, 0, 1, 1)
            grid.attach(name_entry, 1, 0, 1, 1)
            grid.attach(Gtk.Label(label="Mocktail", xalign=1), 0, 1, 1, 1)
            grid.attach(combo, 1, 1, 1, 1)
            hint = dim(Gtk.Label(xalign=0))
            grid.attach(hint, 1, 2, 1, 1)
            area.pack_start(grid, False, False, 0)

            donors = [i for i in list_instances() if i.has_payload() and not i.running()]
            seed_check = Gtk.CheckButton(
                label=(f"Copy the Roblox download from \u201c{donors[0].name}\u201d "
                       "(skips a big download; best-effort)") if donors
                else "Copy the Roblox download from another instance")
            seed_check.set_sensitive(bool(donors))
            if not donors:
                seed_check.set_tooltip_text("Launch an instance once first, then stop it.")
            area.pack_start(seed_check, False, False, 0)

            expander = Gtk.Expander(label="Advanced")
            eb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            eb.set_margin_top(6)
            eb.pack_start(Gtk.Label(label="Extra environment variables, one KEY=VALUE per line",
                                    xalign=0), False, False, 0)
            envview = Gtk.TextView()
            envview.set_monospace(True)
            esw = Gtk.ScrolledWindow()
            esw.set_shadow_type(Gtk.ShadowType.IN)
            esw.set_min_content_height(70)
            esw.add(envview)
            eb.pack_start(esw, True, True, 0)
            expander.add(eb)
            area.pack_start(expander, False, False, 0)

            err = Gtk.Label(xalign=0)
            err.get_style_context().add_class("error")
            err.set_line_wrap(True)
            area.pack_start(err, False, False, 0)

            def names_from_entry():
                return [n for n in re.split(r"[,\s]+", name_entry.get_text().strip()) if n]

            def env_text():
                b = envview.get_buffer()
                return b.get_text(b.get_start_iter(), b.get_end_iter(), False)

            def validate(*_):
                problem = ""
                names = names_from_entry()
                for n in names:
                    if not NAME_RE.match(n):
                        problem = f"\u201c{n}\u201d isn't a valid name (letters, digits, . _ -; max 32)."
                        break
                    if Instance(n).dir.exists():
                        problem = f"\u201c{n}\u201d already exists."
                        break
                if not problem and len(set(names)) != len(names):
                    problem = "Names must be unique."
                if not problem:
                    try:
                        _parse_env_text(env_text())
                    except Error as e:
                        problem = str(e)
                v = (combo.get_active_text() or "").strip()
                hint.set_text("" if not v else ("Already downloaded." if v in cached()
                              else "Will be downloaded from GitHub (~160 MB)."))
                err.set_text(problem)
                ok.set_sensitive(bool(names) and not problem)

            name_entry.connect("changed", validate)
            combo.connect("changed", validate)
            envview.get_buffer().connect("changed", validate)
            validate()
            area.show_all()

            resp = dlg.run()
            names = names_from_entry()
            version = (combo.get_active_text() or "").strip() or None
            seed = donors[0].name if (donors and seed_check.get_active()) else None
            env = {}
            try:
                env = _parse_env_text(env_text())
            except Error:
                pass
            dlg.destroy()
            if resp != Gtk.ResponseType.OK or not names:
                return

            def work(p):
                for n in names:
                    create_instance(n, version=version, env=env, seed=seed, progress=p)
                return "Created " + ", ".join(names)
            self.run_job("Creating " + ", ".join(names), work)

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="org.mocktailmulti.Launcher",
                             flags=Gio.ApplicationFlags.FLAGS_NONE)

        def do_activate(self):
            if not getattr(self, "_css", False):
                install_status_css()
                self._css = True
            win = self.props.active_window or MainWindow(self)
            win.present()

    return App, MainWindow


