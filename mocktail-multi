#!/usr/bin/env python3
"""mocktail-multi - run several Mocktail (Roblox on Linux) instances side by side.

How it works
    Mocktail takes an flock on /run/user/<uid>/mocktail.<hash>.instance.lock, where
    <hash> is derived from the path of the AppImage it was started from. So every
    instance here gets:
      * its own copy of the AppImage            -> its own lock
      * its own MOCKTAIL_{CONFIG,DATA,CACHE,STATE}_ROOT -> its own login, config,
                                                  Roblox payload and logs

Layout (override the root with $MOCKTAIL_MULTI_HOME)
    ~/.local/share/mocktail-multi/appimages/Mocktail-<ver>-x86_64.AppImage
    ~/.local/share/mocktail-multi/instances/<name>/{Mocktail.AppImage,config,data,
                                                    cache,state,meta.json,console.log}

Python 3.8+, standard library only (the GUI additionally needs PyGObject + GTK 3).
Run with no arguments to open the GUI, or the TUI when there is no display.
"""
from __future__ import annotations

import argparse
import curses
import hashlib
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

REPO = "komaruworld/mocktail"
DEFAULT_VERSION = "1.0.4"
ARCH = "x86_64"
UA = "mocktail-multi/1.0"
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,31}$")
ASSET_RE = re.compile(r"^Mocktail-(.+)-%s\.AppImage$" % ARCH)


def _root() -> Path:
    override = os.environ.get("MOCKTAIL_MULTI_HOME")
    if override:
        return Path(override).expanduser()
    base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
    return Path(base) / "mocktail-multi"


ROOT = _root()
APPIMAGES = ROOT / "appimages"
INSTANCES = ROOT / "instances"


class Error(Exception):
    pass


# --------------------------------------------------------------------------- utils

def paint(text: str, code: str) -> str:
    if sys.stdout.isatty() and not os.environ.get("NO_COLOR"):
        return f"\033[{code}m{text}\033[0m"
    return text


def human(n: float) -> str:
    n = float(n)
    for unit in ("B", "KiB", "MiB", "GiB"):
        if n < 1024:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TiB"


def vkey(version: str):
    return tuple(int(x) for x in re.findall(r"\d+", version))


def rmtree_force(path: Path) -> None:
    """rmtree that copes with the read-only dirs Mocktail's payload store creates."""
    for dirpath, _dirs, _files in os.walk(path):
        try:
            os.chmod(dirpath, 0o700)
        except OSError:
            pass
    shutil.rmtree(path)


def clone_or_copy(src, dst, *, follow_symlinks=True):
    """Reflink (instant, no extra disk on btrfs/xfs) when possible, else plain copy."""
    try:
        import fcntl
        with open(src, "rb") as s, open(dst, "wb") as d:
            fcntl.ioctl(d.fileno(), 0x40049409, s.fileno())  # FICLONE
        shutil.copystat(src, dst)
        return dst
    except (OSError, ImportError):
        return shutil.copy2(src, dst)


def tail_lines(path: Path, n: int = 200, max_bytes: int = 262144):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            data = f.read()
    except OSError:
        return []
    text = data.decode("utf-8", "replace")
    text = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", text)
    text = re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "", text.replace("\r", "\n"))
    return text.splitlines()[-n:]


# ----------------------------------------------------------------- process / locks

def proc_start(pid: int):
    """Start time (clock ticks) of a live, non-zombie process, else None."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            rest = f.read().rsplit(")", 1)[1].split()
        if rest[0] in ("Z", "X"):
            return None
        return int(rest[19])
    except (OSError, IndexError, ValueError):
        return None


def fnv1a64(data: bytes) -> int:
    h = 14695981039346656037
    for b in data:
        h ^= b
        h = (h * 1099511628211) & 0xFFFFFFFFFFFFFFFF
    return h


def lock_path(appimage: Path) -> Path:
    """Where Mocktail keeps the single-instance lock for this AppImage path."""
    key = f"{fnv1a64(os.fsencode(os.path.realpath(appimage))):016x}"
    uid = os.getuid()
    run = Path("/run/user") / str(uid)
    try:
        st = run.stat()
        if stat.S_ISDIR(st.st_mode) and st.st_uid == uid:
            return run / f"mocktail.{key}.instance.lock"
    except OSError:
        pass
    return Path("/tmp") / f"mocktail-{uid}.{key}.instance.lock"


def lock_holder(lockfile: Path):
    """PID holding an flock on lockfile, read from /proc/locks (never touches the lock)."""
    try:
        ino = os.stat(lockfile).st_ino
        with open("/proc/locks") as f:
            for line in f:
                p = line.split()
                if len(p) >= 6 and p[1] == "FLOCK":
                    parts = p[5].split(":")
                    if len(parts) == 3 and parts[2].isdigit() and int(parts[2]) == ino:
                        return int(p[4])
    except (OSError, ValueError):
        pass
    return None


_CHILDREN: dict = {}


def reap():
    """Poll children we spawned (prevents zombies). Returns [(name, exit_code)] that ended."""
    ended = []
    for name, proc in list(_CHILDREN.items()):
        code = proc.poll()
        if code is not None:
            ended.append((name, code))
            del _CHILDREN[name]
    return ended


# ------------------------------------------------------------------ AppImage fetch

def asset_name(version: str) -> str:
    return f"Mocktail-{version}-{ARCH}.AppImage"


def asset_url(version: str) -> str:
    return f"https://github.com/{REPO}/releases/download/{version}/{asset_name(version)}"


def is_appimage(path: Path) -> bool:
    try:
        with open(path, "rb") as f:
            head = f.read(16)
    except OSError:
        return False
    return head[:4] == b"\x7fELF" and head[8:10] == b"AI"


def cached() -> dict:
    out = {}
    for p in APPIMAGES.glob("Mocktail-*.AppImage"):
        m = ASSET_RE.match(p.name)
        if m and is_appimage(p):
            out[m.group(1)] = p
    return dict(sorted(out.items(), key=lambda kv: vkey(kv[0])))


def newest_cached():
    versions = list(cached())
    return versions[-1] if versions else None


def latest_release():
    req = urllib.request.Request(
        f"https://api.github.com/repos/{REPO}/releases/latest",
        headers={"User-Agent": UA, "Accept": "application/vnd.github+json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            data = json.load(r)
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise Error(f"could not ask GitHub for the latest release: {e}")
    for asset in data.get("assets", []):
        m = ASSET_RE.match(asset.get("name", ""))
        if m:
            return m.group(1), asset["browser_download_url"]
    raise Error("the latest release has no x86_64 AppImage asset")


def fetch(version=None, latest=False, force=False, progress=None):
    """Download an AppImage into the cache. Returns (version, path, sha256-or-None)."""
    if latest:
        version, url = latest_release()
    else:
        version = version or DEFAULT_VERSION
        url = asset_url(version)
    dest = APPIMAGES / asset_name(version)
    if not force and dest.exists() and is_appimage(dest):
        return version, dest, None

    APPIMAGES.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = dest.with_name(dest.name + ".part")
    digest = hashlib.sha256()
    try:
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=30) as resp, open(tmp, "wb") as out:
            total = int(resp.headers.get("Content-Length") or 0)
            done = 0
            while True:
                chunk = resp.read(1 << 16)
                if not chunk:
                    break
                out.write(chunk)
                digest.update(chunk)
                done += len(chunk)
                if progress:
                    progress(done, total)
    except (urllib.error.URLError, OSError) as e:
        tmp.unlink(missing_ok=True)
        hint = " (is that a real release tag?)" if getattr(e, "code", None) == 404 else ""
        raise Error(f"download failed: {url}: {e}{hint}")
    if not is_appimage(tmp):
        tmp.unlink(missing_ok=True)
        raise Error(f"{url} did not return an AppImage")
    tmp.chmod(0o755)
    os.replace(tmp, dest)
    return version, dest, digest.hexdigest()


def ensure_appimage(version=None, latest=False, progress=None):
    """Return (version, path) of a cached AppImage, downloading if needed."""
    if latest:
        ver, path, _ = fetch(latest=True, progress=progress)
        return ver, path
    if version:
        ver, path, _ = fetch(version, progress=progress)
        return ver, path
    ver = newest_cached()
    if ver:
        return ver, cached()[ver]
    ver, path, _ = fetch(DEFAULT_VERSION, progress=progress)
    return ver, path


# ---------------------------------------------------------------------- instances

class Instance:
    def __init__(self, name: str):
        self.name = name
        self.dir = INSTANCES / name
        self.appimage = self.dir / "Mocktail.AppImage"
        self.meta_file = self.dir / "meta.json"
        self.pidfile = self.dir / "pid"
        self.log = self.dir / "console.log"

    def exists(self) -> bool:
        return self.meta_file.exists()

    def meta(self) -> dict:
        try:
            return json.loads(self.meta_file.read_text())
        except (OSError, ValueError):
            return {}

    def save_meta(self, meta: dict) -> None:
        tmp = self.meta_file.with_name("meta.json.tmp")
        tmp.write_text(json.dumps(meta, indent=2) + "\n")
        os.replace(tmp, self.meta_file)

    @property
    def version(self) -> str:
        return self.meta().get("version", "?")

    def env(self) -> dict:
        env = os.environ.copy()
        for k in ("APPIMAGE", "APPDIR", "ARGV0", "OWD"):
            env.pop(k, None)
        env.update({
            "MOCKTAIL_CONFIG_ROOT": str(self.dir / "config"),
            "MOCKTAIL_DATA_ROOT": str(self.dir / "data"),
            "MOCKTAIL_CACHE_ROOT": str(self.dir / "cache"),
            "MOCKTAIL_STATE_ROOT": str(self.dir / "state"),
        })
        env.update({str(k): str(v) for k, v in self.meta().get("env", {}).items()})
        return env

    def lockfile(self) -> Path:
        return lock_path(self.appimage)

    def leader(self):
        """PID of the process we launched, if it is still the same live process."""
        try:
            pid_s, start_s = self.pidfile.read_text().split()
            pid = int(pid_s)
        except (OSError, ValueError):
            return None
        return pid if str(proc_start(pid)) == start_s else None

    def holder(self):
        return lock_holder(self.lockfile())

    def running(self) -> bool:
        return self.leader() is not None or self.holder() is not None

    def status(self):
        """(label, pid, seconds-up)"""
        holder, leader = self.holder(), self.leader()
        if holder is None and leader is None:
            return "stopped", None, None
        try:
            age = time.time() - self.pidfile.stat().st_mtime
        except OSError:
            age = None
        if holder is None and age is not None and age < 30:
            return "starting", leader, age
        return "running", holder or leader, age

    def has_payload(self) -> bool:
        return (self.dir / "data" / "current.json").exists()


def get_instance(name: str) -> Instance:
    inst = Instance(name)
    if not NAME_RE.match(name) or not inst.exists():
        raise Error(f"no such instance: {name}")
    return inst


def list_instances():
    if not INSTANCES.is_dir():
        return []
    return [Instance(p.name) for p in sorted(INSTANCES.iterdir())
            if p.is_dir() and (p / "meta.json").exists()]


def seed_payloads(donor: Instance, target: Instance) -> None:
    """Copy the donor's downloaded Roblox payload so the new instance skips the download.

    Best-effort: if Mocktail decides the copy is not valid it will simply download again.
    """
    if donor.running():
        raise Error(f"stop '{donor.name}' first (its payload store may be mid-write)")
    src = donor.dir / "data"
    if not (src / "current.json").exists():
        raise Error(f"'{donor.name}' has no downloaded payload yet (launch it once first)")
    dst = target.dir / "data"
    for item in ("payloads", "current.json", "previous_good.json"):
        s = src / item
        if s.is_dir():
            shutil.copytree(s, dst / item, symlinks=True, copy_function=clone_or_copy)
        elif s.exists():
            clone_or_copy(s, dst / item)


def create_instance(name, version=None, env=None, seed=None, progress=None) -> Instance:
    if not NAME_RE.match(name):
        raise Error(f"bad name '{name}' (letters, digits, . _ -; max 32 chars)")
    inst = Instance(name)
    if inst.dir.exists():
        raise Error(f"instance '{name}' already exists")
    donor = get_instance(seed) if seed else None
    ver, src = ensure_appimage(version, progress=progress)

    INSTANCES.mkdir(parents=True, exist_ok=True, mode=0o700)
    inst.dir.mkdir(mode=0o700)
    try:
        for sub in ("config", "data", "cache", "state"):
            (inst.dir / sub).mkdir(mode=0o700)
        clone_or_copy(src, inst.appimage)
        inst.appimage.chmod(0o755)
        if donor:
            seed_payloads(donor, inst)
        inst.save_meta({"name": name, "version": ver, "env": env or {},
                        "created": time.strftime("%Y-%m-%dT%H:%M:%S")})
    except BaseException:
        rmtree_force(inst.dir)
        raise
    return inst


def upgrade_instance(inst: Instance, version=None, latest=False, progress=None) -> str:
    if inst.running():
        raise Error(f"stop '{inst.name}' before upgrading it")
    ver, src = ensure_appimage(version, latest=latest, progress=progress)
    tmp = inst.dir / "Mocktail.AppImage.new"
    clone_or_copy(src, tmp)
    tmp.chmod(0o755)
    os.replace(tmp, inst.appimage)  # same path => same lock key
    meta = inst.meta()
    meta["version"] = ver
    inst.save_meta(meta)
    return ver


def start(inst: Instance):
    if inst.running():
        raise Error(f"{inst.name} is already running")
    if not inst.appimage.exists():
        raise Error(f"{inst.name}: AppImage is missing (try: upgrade {inst.name})")
    if inst.log.exists() and inst.log.stat().st_size > 5 * 1024 * 1024:
        os.replace(inst.log, inst.log.with_name("console.log.1"))
    with open(inst.log, "ab") as logf:
        logf.write(f"\n=== {time.strftime('%F %T')} starting {inst.name} ===\n".encode())
        logf.flush()
        proc = subprocess.Popen(
            [str(inst.appimage)], cwd=inst.dir, env=inst.env(),
            stdin=subprocess.DEVNULL, stdout=logf, stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    started = proc_start(proc.pid)
    if started is not None:
        inst.pidfile.write_text(f"{proc.pid} {started}\n")
    _CHILDREN[inst.name] = proc
    return proc


def stop(inst: Instance, timeout: float = 8.0) -> bool:
    leader, holder = inst.leader(), inst.holder()
    if leader is None and holder is None:
        return False

    def send(sig):
        if leader is not None:
            try:
                os.killpg(leader, sig)  # we launched it with setsid, so pgid == pid
            except OSError:
                pass
        if holder is not None:
            try:
                os.kill(holder, sig)
            except OSError:
                pass

    send(signal.SIGTERM)
    deadline = time.time() + timeout
    while time.time() < deadline and inst.running():
        reap()
        time.sleep(0.2)
    if inst.running():
        send(signal.SIGKILL)
        deadline = time.time() + 3
        while time.time() < deadline and inst.running():
            reap()
            time.sleep(0.2)
    reap()
    inst.pidfile.unlink(missing_ok=True)
    return True


def failure_hint(log_text: str) -> str:
    t = log_text.lower()
    if "already running" in t:
        return "another process holds this instance's lock - stop it first"
    if "libfuse" in t or ("fuse" in t and "mount" in t):
        return ("the AppImage needs FUSE 2 - install libfuse2, or create the instance "
                "with -e APPIMAGE_EXTRACT_AND_RUN=1 (or add it under \"env\" in meta.json)")
    return ""


# -------------------------------------------------------------------------- CLI

def cmd_fetch(args):
    def progress(done, total):
        if sys.stdout.isatty():
            pct = f" {done * 100 // total}%" if total else ""
            print(f"\r  {human(done)} / {human(total) if total else '?'}{pct}   ",
                  end="", flush=True)
    ver, path, sha = fetch(args.version, latest=args.latest, force=args.force,
                           progress=progress)
    if sys.stdout.isatty() and sha:
        print()
    if sha:
        print(f"downloaded {path.name}  sha256 {sha}")
    else:
        print(f"already cached: {path}")


def cmd_new(args):
    env = {}
    for item in args.env or []:
        if "=" not in item:
            raise Error(f"--env expects KEY=VALUE, got '{item}'")
        k, v = item.split("=", 1)
        env[k] = v
    seed = args.seed_from
    if args.seed and not seed:
        donors = [i for i in list_instances() if i.has_payload() and not i.running()]
        if not donors:
            raise Error("--seed: no stopped instance with a downloaded payload to copy from")
        seed = donors[0].name

    def progress(done, total):
        if sys.stdout.isatty():
            print(f"\r  downloading AppImage: {human(done)} / "
                  f"{human(total) if total else '?'}   ", end="", flush=True)

    for name in args.names:
        inst = create_instance(name, version=args.version, env=env, seed=seed,
                               progress=progress)
        if sys.stdout.isatty():
            print()
        extra = f", payload seeded from {seed}" if seed else ""
        print(f"created {inst.name} (Mocktail {inst.version}{extra}) -> {inst.dir}")


def _pick(args):
    if args.all:
        return list_instances()
    if not args.names:
        raise Error("give instance name(s) or --all")
    return [get_instance(n) for n in args.names]


def _start_checked(inst: Instance, settle: float = 2.5) -> str:
    proc = start(inst)
    end = time.time() + settle
    while time.time() < end and proc.poll() is None:
        time.sleep(0.1)
    if proc.poll() is not None:
        # It may have handed off to another process (memory-limit re-exec); give the lock a moment.
        end = time.time() + 3
        while time.time() < end and not inst.running():
            time.sleep(0.2)
        if not inst.running():
            tail = "\n".join(tail_lines(inst.log, 12))
            hint = failure_hint(tail)
            raise Error(f"{inst.name} exited immediately (code {proc.returncode}); last output:\n"
                        f"{tail}\n" + (f"hint: {hint}\n" if hint else ""))
    return f"started {inst.name} (pid {proc.pid})"


def cmd_start(args):
    failed = 0
    for inst in _pick(args):
        try:
            print(_start_checked(inst))
        except Error as e:
            print(paint(f"error: {e}", "31"), file=sys.stderr)
            failed += 1
    return 1 if failed else 0


def cmd_stop(args):
    for inst in _pick(args):
        print(f"stopped {inst.name}" if stop(inst) else f"{inst.name} was not running")


def cmd_restart(args):
    for inst in _pick(args):
        stop(inst)
        print(_start_checked(inst))


def cmd_upgrade(args):
    for inst in _pick(args):
        old = inst.version
        ver = upgrade_instance(inst, version=args.version, latest=args.latest)
        print(f"{inst.name}: {old} -> {ver}")


def cmd_rm(args):
    for inst in [get_instance(n) for n in args.names]:
        if inst.running():
            raise Error(f"{inst.name} is running - stop it first")
        if not args.yes:
            ans = input(f"delete '{inst.name}' including its login session and data? [y/N] ")
            if ans.strip().lower() != "y":
                print("skipped", inst.name)
                continue
        rmtree_force(inst.dir)
        print(f"removed {inst.name}")


def cmd_list(_args):
    insts = list_instances()
    if not insts:
        print(f"no instances yet. Create one with:  {os.path.basename(sys.argv[0])} new NAME")
        return
    width = max(8, max(len(i.name) for i in insts))
    print(paint(f"{'NAME':<{width}}  {'VERSION':<8}  {'STATUS':<9}  PID", "1"))
    for inst in insts:
        label, pid, _ = inst.status()
        color = {"running": "32", "starting": "33"}.get(label, "2")
        print(f"{inst.name:<{width}}  {inst.version:<8}  {paint(f'{label:<9}', color)}  "
              f"{pid or '-'}")


def cmd_logs(args):
    inst = get_instance(args.name)
    for line in tail_lines(inst.log, args.lines):
        print(line)
    if not args.follow:
        return
    try:
        with open(inst.log, "rb") as f:
            f.seek(0, os.SEEK_END)
            while True:
                data = f.read()
                if data:
                    sys.stdout.write(data.decode("utf-8", "replace"))
                    sys.stdout.flush()
                else:
                    time.sleep(0.4)
    except (OSError, KeyboardInterrupt):
        pass


def cmd_path(args):
    print(get_instance(args.name).dir)


# -------------------------------------------------------------------------- TUI

class Job:
    """Runs fn(progress) in a thread so the UI keeps redrawing."""

    def __init__(self, label, fn):
        self.label = label
        self.done = 0
        self.total = 0
        self.error = None
        self.result = ""
        self.finished = False
        threading.Thread(target=self._run, args=(fn,), daemon=True).start()

    def _run(self, fn):
        try:
            self.result = fn(self.progress) or ""
        except Error as e:
            self.error = str(e)
        except Exception as e:  # keep the TUI alive whatever happens
            self.error = f"{type(e).__name__}: {e}"
        finally:
            self.finished = True

    def progress(self, done, total):
        self.done, self.total = done, total


class UI:
    def __init__(self):
        self.sel = 0
        self.job = None
        self.flash = ""
        self.flash_bad = False
        self.flash_until = 0.0

    def say(self, text, bad=False, secs=6):
        self.flash, self.flash_bad, self.flash_until = text, bad, time.time() + secs


def _put(scr, y, x, text, attr=0):
    h, w = scr.getmaxyx()
    if 0 <= y < h and 0 <= x < w - 1:
        try:
            scr.addnstr(y, x, text, w - x - 1, attr)
        except curses.error:
            pass


def _prompt(scr, label, default=""):
    h, w = scr.getmaxyx()
    buf = list(default)
    scr.timeout(-1)
    try:
        curses.curs_set(1)
    except curses.error:
        pass
    try:
        while True:
            line = f" {label}: {''.join(buf)}"
            scr.move(h - 2, 0)
            scr.clrtoeol()
            _put(scr, h - 2, 0, line, curses.A_BOLD)
            scr.move(h - 2, min(len(line), w - 2))
            scr.refresh()
            ch = scr.get_wch()
            if ch in ("\n", "\r") or ch == curses.KEY_ENTER:
                return "".join(buf).strip()
            if ch == "\x1b":
                return None
            if ch in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                if buf:
                    buf.pop()
            elif isinstance(ch, str) and ch.isprintable():
                buf.append(ch)
    finally:
        try:
            curses.curs_set(0)
        except curses.error:
            pass


def _confirm(scr, question) -> bool:
    h, _w = scr.getmaxyx()
    scr.timeout(-1)
    scr.move(h - 2, 0)
    scr.clrtoeol()
    _put(scr, h - 2, 0, f" {question} [y/N] ", curses.A_BOLD)
    scr.refresh()
    return scr.getch() in (ord("y"), ord("Y"))


def _view_log(scr, inst: Instance):
    follow, top = True, 0
    while True:
        lines = tail_lines(inst.log, 3000)
        h, w = scr.getmaxyx()
        view = max(1, h - 2)
        top = max(0, len(lines) - view) if follow else max(0, min(top, len(lines) - view))
        scr.erase()
        _put(scr, 0, 0, f" log: {inst.name}   q back | arrows/PgUp/PgDn scroll | g top | "
                        f"G/f follow ({'on' if follow else 'off'})".ljust(w), curses.A_REVERSE)
        for i, line in enumerate(lines[top:top + view]):
            _put(scr, 1 + i, 0, line.expandtabs(4))
        scr.refresh()
        scr.timeout(500)
        ch = scr.getch()
        if ch in (ord("q"), 27):
            return
        if ch == curses.KEY_UP:
            follow, top = False, top - 1
        elif ch == curses.KEY_DOWN:
            top += 1
            follow = top >= len(lines) - view
        elif ch == curses.KEY_PPAGE:
            follow, top = False, top - view
        elif ch == curses.KEY_NPAGE:
            top += view
            follow = top >= len(lines) - view
        elif ch == ord("g"):
            follow, top = False, 0
        elif ch in (ord("G"), ord("f")):
            follow = not follow if ch == ord("f") else True


def _draw(scr, ui: UI, insts, colors):
    green, yellow, red, cyan = colors
    scr.erase()
    h, w = scr.getmaxyx()
    _put(scr, 0, 0, " mocktail-multi ".ljust(w), curses.A_REVERSE)
    have = cached()
    if have:
        newest = list(have)[-1]
        _put(scr, 1, 1, "AppImages: " + "  ".join(
            f"{v}{' (newest)' if v == newest else ''}" for v in have), cyan)
    else:
        _put(scr, 1, 1, "No AppImage downloaded yet - press f (or n, which fetches one).", yellow)

    nw = min(24, max(8, max((len(i.name) for i in insts), default=8)))
    _put(scr, 3, 1, f"{'NAME':<{nw}}  {'VERSION':<8}  {'STATUS':<9}  {'PID':>7}  UP",
         curses.A_BOLD | curses.A_UNDERLINE)
    if not insts:
        _put(scr, 5, 1, "No instances yet. Press n to create one.")
    for row, inst in enumerate(insts):
        y = 4 + row
        if y >= h - 3:
            break
        label, pid, age = inst.status()
        up = ""
        if label != "stopped" and age is not None:
            up = f"{int(age // 3600)}h{int(age % 3600 // 60):02d}m" if age >= 3600 \
                else f"{int(age // 60)}m{int(age % 60):02d}s"
        base = curses.A_REVERSE if row == ui.sel else 0
        _put(scr, y, 1, f"{inst.name:<{nw}}  {inst.version:<8}  ".ljust(w - 2), base)
        color = {"running": green, "starting": yellow}.get(label, 0)
        _put(scr, y, 1 + nw + 2 + 8 + 2, f"{label:<9}", color | base)
        _put(scr, y, 1 + nw + 2 + 8 + 2 + 11, f"{pid or '-':>7}  {up}", base)

    if ui.job and not ui.job.finished:
        j = ui.job
        if j.total:
            frac = min(1.0, j.done / j.total)
            bar = "#" * int(frac * 24) + "-" * (24 - int(frac * 24))
            text = f" {j.label} [{bar}] {int(frac * 100)}%  {human(j.done)}/{human(j.total)}"
        else:
            text = f" {j.label} ..." + ("." * (int(time.time() * 3) % 4))
        _put(scr, h - 2, 0, text, yellow | curses.A_BOLD)
    elif ui.flash and time.time() < ui.flash_until:
        _put(scr, h - 2, 0, " " + ui.flash, (red if ui.flash_bad else green) | curses.A_BOLD)
    hints = (" n new | enter start/stop | s start | x stop | r restart | l log | f fetch | "
             "u upgrade | d delete | A/X all | q quit")
    _put(scr, h - 1, 0, hints.ljust(w), curses.A_REVERSE)
    scr.refresh()


def _tui(scr):
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    colors = (0, 0, 0, 0)
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        for i, c in enumerate((curses.COLOR_GREEN, curses.COLOR_YELLOW,
                               curses.COLOR_RED, curses.COLOR_CYAN), 1):
            curses.init_pair(i, c, -1)
        colors = tuple(curses.color_pair(i) for i in range(1, 5))

    ui = UI()
    while True:
        for name, code in reap():
            inst = Instance(name)
            if code != 0 and not inst.running():
                ui.say(f"{name} exited with code {code} - press l to read its log", bad=True, secs=15)
        if ui.job and ui.job.finished:
            if ui.job.error:
                ui.say(ui.job.error.splitlines()[0], bad=True, secs=12)
            else:
                ui.say(ui.job.result or "done")
            ui.job = None

        insts = list_instances()
        ui.sel = max(0, min(ui.sel, len(insts) - 1))
        _draw(scr, ui, insts, colors)
        scr.timeout(120 if ui.job else 1000)
        ch = scr.getch()
        if ch == -1 or ch == curses.KEY_RESIZE or ui.job:
            continue

        key = chr(ch) if 0 <= ch < 256 else ""
        cur = insts[ui.sel] if insts else None
        if key == "q":
            break
        elif ch == curses.KEY_DOWN or key == "j":
            ui.sel = min(len(insts) - 1, ui.sel + 1)
        elif ch == curses.KEY_UP or key == "k":
            ui.sel = max(0, ui.sel - 1)
        elif ch == curses.KEY_HOME or key == "g":
            ui.sel = 0
        elif ch == curses.KEY_END or key == "G":
            ui.sel = max(0, len(insts) - 1)
        elif key == "n":
            name = _prompt(scr, "new instance name")
            if not name:
                continue
            if not NAME_RE.match(name):
                ui.say("bad name (letters, digits, . _ -; max 32)", bad=True)
                continue
            if Instance(name).exists():
                ui.say(f"'{name}' already exists", bad=True)
                continue
            seed = None
            donors = [i for i in insts if i.has_payload() and not i.running()]
            if donors and _confirm(scr, f"copy the Roblox payload from '{donors[0].name}' "
                                        f"(skips a big download, best-effort)?"):
                seed = donors[0].name
            ui.job = Job(f"creating {name}", lambda p, n=name, s=seed: (
                create_instance(n, seed=s, progress=p) and f"created {n}"))
        elif key == "f":
            ver = _prompt(scr, "AppImage version to download (tag, or 'latest')", DEFAULT_VERSION)
            if ver is None:
                continue
            ver = ver or DEFAULT_VERSION

            def do_fetch(p, v=ver):
                got, _path, sha = fetch(None if v == "latest" else v, latest=(v == "latest"),
                                        progress=p)
                return f"downloaded Mocktail {got}" if sha else f"Mocktail {got} already cached"
            ui.job = Job(f"downloading {ver}", do_fetch)
        elif key == "A":
            todo = [i for i in insts if not i.running()]

            def start_all(_p, items=todo):
                for i in items:
                    start(i)
                    time.sleep(1.0)
                return f"started {len(items)} instance(s)"
            if todo:
                ui.job = Job("starting all", start_all)
        elif key == "X":
            todo = [i for i in insts if i.running()]
            if todo:
                ui.job = Job("stopping all", lambda p, items=todo: (
                    [stop(i) for i in items], f"stopped {len(items)} instance(s)")[1])
        elif cur is None:
            continue
        elif ch in (10, 13, curses.KEY_ENTER):
            if cur.running():
                ui.job = Job(f"stopping {cur.name}", lambda p, i=cur: stop(i) and f"stopped {i.name}")
            else:
                try:
                    start(cur)
                    ui.say(f"starting {cur.name} ...")
                except Error as e:
                    ui.say(str(e), bad=True)
        elif key == "s":
            try:
                start(cur)
                ui.say(f"starting {cur.name} ...")
            except Error as e:
                ui.say(str(e), bad=True)
        elif key == "x":
            if cur.running():
                ui.job = Job(f"stopping {cur.name}", lambda p, i=cur: stop(i) and f"stopped {i.name}")
            else:
                ui.say(f"{cur.name} is not running")
        elif key == "r":
            def restart(_p, i=cur):
                stop(i)
                start(i)
                return f"restarted {i.name}"
            ui.job = Job(f"restarting {cur.name}", restart)
        elif key == "l":
            _view_log(scr, cur)
        elif key == "u":
            newest = newest_cached()
            if cur.running():
                ui.say("stop it first", bad=True)
            elif newest is None or newest == cur.version:
                ui.say(f"{cur.name} already has the newest downloaded AppImage "
                       f"({cur.version}); press f to fetch another version")
            else:
                ui.job = Job(f"upgrading {cur.name}", lambda p, i=cur, v=newest: (
                    upgrade_instance(i, version=v, progress=p) and f"{i.name} -> {v}"))
        elif key == "d":
            if cur.running():
                ui.say("stop it first", bad=True)
            elif _confirm(scr, f"delete '{cur.name}' and its login session/data?"):
                ui.job = Job(f"deleting {cur.name}", lambda p, i=cur: (
                    rmtree_force(i.dir), f"removed {i.name}")[1])


def cmd_tui(_args=None):
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise Error("the TUI needs a terminal; use `list`, `start`, `stop`, ... instead")
    curses.wrapper(_tui)
    running = [i.name for i in list_instances() if i.running()]
    if running:
        print(f"still running (detached): {', '.join(running)}   -> `{os.path.basename(sys.argv[0])} stop --all` to close them")


