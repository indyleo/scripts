        def scroll_end(self):
            mark = self.buf.get_mark("end") or self.buf.create_mark(
                "end", self.buf.get_end_iter(), False)
            self.buf.move_mark(mark, self.buf.get_end_iter())
            self.view.scroll_to_mark(mark, 0.0, False, 0.0, 0.0)
            return False

