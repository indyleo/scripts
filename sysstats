#!/usr/bin/env bash

# Strict mode: Exit on error, unset vars, and pipe failures
set -euo pipefail

opt="${1:-}"

SYSCTL="sysctl"
CLICK_LOG="${XDG_RUNTIME_DIR:-/tmp}/sysstats-click.log"

# dwm's FIFO IPC (ipc.c / fifocmds[]) - confirmed protocol: a line of
# "<cmd> <int-arg>\n" written to this path. Used below to pop open the
# wiremixsc scratchpad (config.h: spcmd4 = wiremix TUI mixer, scratchpad
# index 3) instead of depending on a GUI mixer like pavucontrol.
DWM_FIFO="/tmp/dwm.fifo"

function handle_block_click() {
    [[ -z "${BLOCK_BUTTON:-}" ]] && return 0

    # Only volume/brightness/mic route through $SYSCTL; the network/battery
    # detail notifications below don't need it, so this guard is scoped to
    # just those instead of gating the whole function.
    case "$opt" in
        volume|brightness|mic|microphone)
            if ! command -v "$SYSCTL" >/dev/null 2>&1; then
                echo "$(date '+%F %T') sysstats: '$SYSCTL' not found on PATH" >> "$CLICK_LOG"
                return 0
            fi
            ;;
    esac

    case "$opt" in
        volume)
            case "$BLOCK_BUTTON" in
                1) "$SYSCTL" vol --toggle >>"$CLICK_LOG" 2>&1 || true ;;   # left:  mute toggle
                3) echo "togglescratch 3" > "$DWM_FIFO" 2>>"$CLICK_LOG" || true ;;  # right: wiremix mixer scratchpad
                4) "$SYSCTL" vol --inc    >>"$CLICK_LOG" 2>&1 || true ;;   # scroll up:   +5%
                5) "$SYSCTL" vol --dec    >>"$CLICK_LOG" 2>&1 || true ;;   # scroll down: -5%
            esac
            ;;
        brightness)
            case "$BLOCK_BUTTON" in
                1) "$SYSCTL" bri --toggle >>"$CLICK_LOG" 2>&1 || true ;;   # left:  dim/undim toggle (10% <-> 100%)
                4) "$SYSCTL" bri --inc    >>"$CLICK_LOG" 2>&1 || true ;;   # scroll up:   +5%
                5) "$SYSCTL" bri --dec    >>"$CLICK_LOG" 2>&1 || true ;;   # scroll down: -5%
            esac
            ;;
        mic|microphone)
            case "$BLOCK_BUTTON" in
                1) "$SYSCTL" mic --toggle >>"$CLICK_LOG" 2>&1 || true ;;   # left:  mute toggle
                4) "$SYSCTL" mic --inc    >>"$CLICK_LOG" 2>&1 || true ;;   # scroll up:   +5%
                5) "$SYSCTL" mic --dec    >>"$CLICK_LOG" 2>&1 || true ;;   # scroll down: -5%
            esac
            ;;
        wifi)
            case "$BLOCK_BUTTON" in
                1)
                    if command -v wifi >/dev/null 2>&1; then
                        setsid -f wifi >>"$CLICK_LOG" 2>&1 || true
                    else
                        echo "$(date '+%F %T') sysstats: 'wifi' script not found on PATH" >> "$CLICK_LOG"
                    fi
                    ;;
                3) notify_wifi_details ;;
            esac
            ;;
        ethernet|eth)
            case "$BLOCK_BUTTON" in
                1) notify_ethernet_details ;;
            esac
            ;;
        tail|tailscale)
            case "$BLOCK_BUTTON" in
                1) notify_tailscale_details ;;
            esac
            ;;
        battery)
            case "$BLOCK_BUTTON" in
                1) notify_battery_details ;;
            esac
            ;;
    esac

    return 0
}

function ttime() {
    date +"󰥔  %I:%M %p"
}

function ddate() {
    date +"  %A %B %d %Y"
}

function date_time() {
    date +"󰥔  %I:%M %p |   %A %B %d %Y"
}

function uptime_info() {
    local up
    up=$(uptime -p | sed 's/up //; s/ hours\?/h/; s/ minutes\?/m/; s/ days\?/d/')
    echo "󱎫 ${up}"
}

function cpu_load() {
    local usage="" temp=""
    local cpu1 cpu2 idle1 idle2 total1 total2

    read -r cpu1 <<< "$(grep '^cpu ' /proc/stat)"
    sleep 0.1
    read -r cpu2 <<< "$(grep '^cpu ' /proc/stat)"

    local -a vals1=($cpu1)
    local -a vals2=($cpu2)

    idle1="${vals1[4]}"
    idle2="${vals2[4]}"

    total1=0
    total2=0
    for ((i=1; i<=7; i++)); do
        total1=$((total1 + ${vals1[$i]:-0}))
        total2=$((total2 + ${vals2[$i]:-0}))
    done

    local total_diff=$((total2 - total1))
    local idle_diff=$((idle2 - idle1))

    if [[ $total_diff -gt 0 ]]; then
        usage=$(awk -v total="$total_diff" -v idle="$idle_diff" 'BEGIN {printf "%.0f", ((total - idle) / total) * 100}')
    else
        usage=0
    fi

    if [[ -d /sys/class/hwmon ]]; then
        for hwmon in /sys/class/hwmon/hwmon*/name; do
            if [[ -f "$hwmon" ]] && grep -q "coretemp\|k10temp\|zenpower" "$hwmon" 2>/dev/null; then
                local hwmon_dir=$(dirname "$hwmon")
                if [[ -f "$hwmon_dir/temp1_input" ]]; then
                    temp=$(cat "$hwmon_dir"/temp1_input 2>/dev/null | awk '{print int($1/1000)}' || echo "")
                    break
                fi
            fi
        done
    fi

    if [[ -n "$temp" ]]; then
        echo "  ${usage}% (${temp}°C)"
    else
        echo "  ${usage}%"
    fi
}

function disk_usage() {
    local mount used_human total_human percent used_gb total_gb
    mount="/"
    read -r used_human total_human percent <<< "$(df -h / | awk 'NR==2 {print $3, $2, $5}')"
    percent="${percent%\%}"

    used_gb=$(echo "$used_human" | awk '{
        val = $1; sub(/[KMGT]/, "", val);
        if ($1 ~ /K/) print val/1024/1024;
        else if ($1 ~ /M/) print val/1024;
        else if ($1 ~ /G/) print val;
        else if ($1 ~ /T/) print val*1024;
        else print val/1024/1024/1024;
    }' | awk '{printf "%.1f", $1}')

    total_gb=$(echo "$total_human" | awk '{
        val = $1; sub(/[KMGT]/, "", val);
        if ($1 ~ /K/) print val/1024/1024;
        else if ($1 ~ /M/) print val/1024;
        else if ($1 ~ /G/) print val;
        else if ($1 ~ /T/) print val*1024;
        else print val/1024/1024/1024;
    }' | awk '{printf "%.1f", $1}')

    echo "󰋊 ${mount}: ${percent}% (${used_gb}G/${total_gb}G)"
}

function memory_usage() {
    local used_kb total_kb used_gb total_gb percent
    read -r total_kb used_kb <<< "$(free | awk 'NR==2 {print $2, $3}')"
    used_gb=$(awk -v used="$used_kb" 'BEGIN {printf "%.1f", used/1024/1024}')
    total_gb=$(awk -v total="$total_kb" 'BEGIN {printf "%.1f", total/1024/1024}')
    percent=$(awk -v used="$used_kb" -v total="$total_kb" 'BEGIN {printf "%.0f", (used/total)*100}')
    echo "  ${percent}% (${used_gb}G/${total_gb}G)"
}

# --- Shared helpers for the click-to-notify details below ---

function _iface_ipv4() {
    ip -4 -o addr show dev "$1" scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1
}

function _iface_ipv6() {
    ip -6 -o addr show dev "$1" scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1
}

function _ping_via() {
    # One ICMP ping out a specific interface. Prints "N ms" or "unreachable".
    local iface="$1" host="${2:-1.1.1.1}" ms
    ms=$(ping -I "$iface" -c1 -W2 "$host" 2>/dev/null | grep -oP 'time=\K[0-9.]+')
    [[ -n "$ms" ]] && echo "${ms}ms" || echo "unreachable"
}

function _public_ipv4() {
    curl -4 -s --max-time 2 ifconfig.me 2>/dev/null || echo ""
}

function _public_ipv6() {
    curl -6 -s --max-time 2 ifconfig.me 2>/dev/null || echo ""
}

function _wifi_iface() {
    nmcli -t -f DEVICE,TYPE,STATE dev status 2>/dev/null |
    awk -F: '$2=="wifi" && $3=="connected"{print $1; exit}'
}

function _eth_iface() {
    # Same physical-interface detection as eethernet(), but returns the
    # connected interface's name instead of just a Connected/Disconnected
    # verdict.
    local dev iface
    for dev in /sys/class/net/*; do
        iface=$(basename "$dev")
        if [[ "$iface" != "lo" && ! -d "$dev/wireless" && -d "$dev/device" ]]; then
            if [[ -f "$dev/carrier" && "$(cat "$dev/carrier" 2>/dev/null)" == "1" ]]; then
                echo "$iface"
                return
            fi
        fi
    done
}

# Builds the "ping | local-v4 -> pub-v4[ | v6]" line shared by the wifi
# and ethernet notifications. Truncates left-to-right if it doesn't fit
# NOTIF_W (notifications.c has no wrapping/multi-line support), so
# field order here doubles as priority order.
function _link_detail_line() {
    local iface="$1" ping4 v4 v6 pub4 pub6 line
    ping4=$(_ping_via "$iface")
    v4=$(_iface_ipv4 "$iface"); [[ -z "$v4" ]] && v4="N/A"
    pub4=$(_public_ipv4); [[ -z "$pub4" ]] && pub4="N/A"
    v6=$(_iface_ipv6 "$iface")
    pub6=$(_public_ipv6)

    line="${ping4} | ${v4} -> ${pub4}"
    [[ -n "$v6" || -n "$pub6" ]] && line+=" | v6 ${v6:-none}"
    echo "$line"
}

function notify_wifi_details() {
    local iface
    iface=$(_wifi_iface)
    if [[ -z "$iface" ]]; then
        notify-send -a sysstats "󰤮 Wi-Fi" "Not connected" 2>/dev/null || true
        return
    fi
    notify-send -a sysstats "󰤮 Wi-Fi (${iface})" "$(_link_detail_line "$iface")" 2>/dev/null || true
}

function notify_ethernet_details() {
    local iface
    iface=$(_eth_iface)
    if [[ -z "$iface" ]]; then
        notify-send -a sysstats "󰲜 Ethernet" "Not connected" 2>/dev/null || true
        return
    fi
    notify-send -a sysstats "󰈀 Ethernet (${iface})" "$(_link_detail_line "$iface")" 2>/dev/null || true
}

function notify_tailscale_details() {
    local status_out state up down v4 v6 body icon
    if ! command -v tailscale &> /dev/null; then
        notify-send -a sysstats "󰈂 Tailscale" "not installed" 2>/dev/null || true
        return
    fi
    status_out=$(tailscale status 2>&1) || true
    if [[ -z "$status_out" ]]; then
        state="Down (unreachable)"; icon="󰈂"
    elif echo "$status_out" | grep -q "Logged out"; then
        state="Down (logged out)"; icon="󰈂"
    else
        state="Up"; icon="󰈁"
        # Peer lines start with an address; "offline" marks a down peer.
        down=$(echo "$status_out" | awk '$1 ~ /^[0-9a-fA-F:.]+$/ && /offline/' | wc -l)
        up=$(echo "$status_out" | awk '$1 ~ /^[0-9a-fA-F:.]+$/ && !/offline/' | wc -l)
    fi

    v4=$(tailscale ip -4 2>/dev/null | head -n1)
    v6=$(tailscale ip -6 2>/dev/null | head -n1)

    body="$state"
    [[ -n "${up:-}" || -n "${down:-}" ]] && body+=" (${up:-0} up, ${down:-0} down)"
    [[ -n "$v4" ]] && body+=" | ${v4}"
    [[ -n "$v6" ]] && body+=" | ${v6}"

    notify-send -a sysstats "${icon} Tailscale" "$body" 2>/dev/null || true
}

function _battery_health() {
    # health% = current full-charge capacity vs. design capacity. Kernels
    # expose this as either energy_* (Wh) or charge_* (Ah) depending on
    # the battery's fuel gauge, so check both.
    local bat_dir full design health="N/A"
    bat_dir=$(find /sys/class/power_supply/ -maxdepth 1 -name 'BAT*' -print -quit 2>/dev/null)
    [[ -z "$bat_dir" ]] && { echo "$health"; return; }
    if [[ -f "$bat_dir/energy_full" && -f "$bat_dir/energy_full_design" ]]; then
        full=$(cat "$bat_dir/energy_full" 2>/dev/null || echo 0)
        design=$(cat "$bat_dir/energy_full_design" 2>/dev/null || echo 0)
    elif [[ -f "$bat_dir/charge_full" && -f "$bat_dir/charge_full_design" ]]; then
        full=$(cat "$bat_dir/charge_full" 2>/dev/null || echo 0)
        design=$(cat "$bat_dir/charge_full_design" 2>/dev/null || echo 0)
    fi
    if [[ -n "${full:-}" && -n "${design:-}" && "${design:-0}" -gt 0 ]]; then
        health=$(awk -v f="$full" -v d="$design" 'BEGIN{printf "%.0f%%", (f/d)*100}')
    fi
    echo "$health"
}

function notify_battery_details() {
    local battery_info first_line status time_left health direction body
    if ! command -v acpi &> /dev/null; then
        notify-send -a sysstats "󰂄 Battery" "acpi not installed" 2>/dev/null || true
        return
    fi
    battery_info=$(acpi -b 2>/dev/null || echo "")
    if [[ -z "$battery_info" ]]; then
        notify-send -a sysstats "󰂄 Battery" "No battery detected" 2>/dev/null || true
        return
    fi
    first_line=$(echo "$battery_info" | head -n1)
    status=$(echo "$first_line" | awk -F', ' '{print $1}' | awk -F': ' '{print $2}')
    time_left=$(echo "$first_line" | grep -oP '\d+:\d+:\d+' | head -n1)
    [[ -n "$time_left" ]] && time_left=$(echo "$time_left" | awk -F: '{printf "%d:%02d", $1, $2}')
    health=$(_battery_health)

    case "$status" in
        Charging) direction="${time_left:-N/A} until full" ;;
        Discharging) direction="${time_left:-N/A} remaining" ;;
        *) direction="" ;;
    esac

    body="${status:-Unknown}"
    [[ -n "$direction" ]] && body+=" | ${direction}"
    body+=" | health ${health}"

    notify-send -a sysstats "󰂄 Battery" "$body" 2>/dev/null || true
}

function eethernet() {
    local interface found=0

    # Iterate through all network interfaces
    for dev in /sys/class/net/*; do
        interface=$(basename "$dev")

        # Filter: Skip loopback, wireless, and virtual interfaces (docker, br, veth, etc.)
        # Physical interfaces usually have a 'device' symlink in sysfs
        if [[ "$interface" != "lo" && ! -d "$dev/wireless" && -d "$dev/device" ]]; then
            # Check the carrier file: 1 means cable is detected and link is up
            if [[ -f "$dev/carrier" ]] && [[ "$(cat "$dev/carrier" 2>/dev/null)" == "1" ]]; then
                echo "󰈀 Connected"
                return
            fi
            found=1
        fi
    done

    # If we found physical ports but none had a carrier
    if [[ $found -eq 1 ]]; then
        echo "󰲜 Disconnected"
    else
        echo "󰲜 No Ethernet"
    fi
}


function wifi_status() {
    local current icon msg quality
    if command -v nmcli &> /dev/null; then
        local nmcli_output active_line
        nmcli_output=$(nmcli -t -f active,ssid,signal dev wifi 2>/dev/null || echo "")
        if [[ -n "$nmcli_output" ]]; then
            active_line=$(echo "$nmcli_output" | grep "^yes:" | head -n 1)
            if [[ -n "$active_line" ]]; then
                current=$(echo "$active_line" | cut -d':' -f2)
                quality=$(echo "$active_line" | cut -d':' -f3)
                if   [[ $quality -ge 75 ]]; then icon="󰤨"
                elif [[ $quality -ge 50 ]]; then icon="󰤥"
                elif [[ $quality -ge 25 ]]; then icon="󰤢"
                else                           icon="󰤟"
                fi
                echo "${icon} ${current} (${quality}%)"
                return
            fi
        fi
        echo "󰤮 Offline"
        return
    fi
    echo "󰤮 No tool"
}

function tail_status() {
    local icon msg status_out
    if ! command -v tailscale &> /dev/null; then
        echo "󰈂 No tool"
        return
    fi
    if status_out=$(tailscale status 2>&1); then
        if echo "$status_out" | grep -q "Logged out"; then
            icon="󰈂"; msg="Not connected"
        else
            icon="󰈁"; msg="Connected"
        fi
    else
        icon="󰈂"; msg="Not connected"
    fi
    echo "${icon} ${msg}"
}

function is_media() {
    local rec=0 stream=0 icon msg rec_mon stream_mon
    [[ -f "/tmp/recpid" ]] && rec=1
    [[ -f "/tmp/streampid" ]] && stream=1
    [[ -f "/tmp/recpid.monitor" ]] && rec_mon="$(cat /tmp/recpid.monitor)"
    [[ -f "/tmp/streampid.monitor" ]] && stream_mon="$(cat /tmp/streampid.monitor)"
    if [[ $rec -eq 1 && $stream -eq 1 ]]; then
        icon="󰑊"
        msg="Rec (${rec_mon:-NA}) | Stream (${stream_mon:-NA})"
    elif [[ $rec -eq 1 ]]; then
        icon="󰑊"
        msg="Recording (${rec_mon:-NA})"
    elif [[ $stream -eq 1 ]]; then
        icon="󰑊"
        msg="Streaming (${stream_mon:-NA})"
    else
        icon=""
        msg="Idle"
    fi
    echo "${icon} ${msg}"
}

function bbattery() {
    local battery_info valid_batteries active_battery_line percent status icon time_left
    if ! command -v acpi &> /dev/null; then
        echo "󰂑 No acpi"; return
    fi
    battery_info=$(acpi -b 2>/dev/null || echo "")
    [[ -z "$battery_info" ]] && return
    valid_batteries=$(echo "$battery_info" | grep -v "Unknown" | grep -v "rate information unavailable" || true)
    active_battery_line=$([[ -n "$valid_batteries" ]] && echo "$valid_batteries" | head -n 1 || echo "$battery_info" | head -n 1)
    percent=$(echo "$active_battery_line" | grep -o '[0-9]\+%' | tr -d '%' | head -n 1 || echo "0")
    status=$(echo "$active_battery_line" | awk -F', ' '{print $1}' | awk -F': ' '{print $2}' || echo "Unknown")
    time_left=$(echo "$active_battery_line" | grep -oP '\d+:\d+:\d+' | head -n 1 || echo "")
    [[ -n "$time_left" ]] && time_left=$(echo "$time_left" | awk -F: '{printf "%d:%02d", $1, $2}')

    case "$status" in
        Charging|Not\ charging)
            if [[ $percent -ge 100 ]]; then icon="󰂅"
            elif [[ $percent -ge 90 ]]; then icon="󰂋"
            elif [[ $percent -ge 80 ]]; then icon="󰂊"
            elif [[ $percent -ge 70 ]]; then icon="󰢞"
            elif [[ $percent -ge 60 ]]; then icon="󰂉"
            elif [[ $percent -ge 50 ]]; then icon="󰢝"
            elif [[ $percent -ge 40 ]]; then icon="󰂈"
            elif [[ $percent -ge 30 ]]; then icon="󰂇"
            elif [[ $percent -ge 20 ]]; then icon="󰂆"
            elif [[ $percent -ge 10 ]]; then icon="󰢜"
        else icon="󰢟"; fi ;;
        Discharging)
            if [[ $percent -ge 100 ]]; then icon="󰁹"
            elif [[ $percent -ge 90 ]]; then icon="󰂂"
            elif [[ $percent -ge 80 ]]; then icon="󰂁"
            elif [[ $percent -ge 70 ]]; then icon="󰂀"
            elif [[ $percent -ge 60 ]]; then icon="󰁿"
            elif [[ $percent -ge 50 ]]; then icon="󰁾"
            elif [[ $percent -ge 40 ]]; then icon="󰁽"
            elif [[ $percent -ge 30 ]]; then icon="󰁼"
            elif [[ $percent -ge 20 ]]; then icon="󰁻"
            elif [[ $percent -ge 10 ]]; then icon="󰁺"
        else icon="󰂎"; fi ;;
        Full) icon="󰂄" ;;
        *) icon="󰂑" ;;
    esac
    [[ -n "$time_left" ]] && echo "${icon} ${percent}% (${time_left})" || echo "${icon} ${percent}%"
}

function _wpctl_pct_muted() {
    # Shared parser for vvolume()/mmicrophone(): one `wpctl get-volume`
    # call, prints "PCT MUTED" (MUTED is 1 or 0). Same wpctl output
    # format ("Volume: 0.NN" / "Volume: 0.NN [MUTED]") that sysctl and
    # osd.c's fastget already parse -- kept in sync with those rather
    # than going through pamixer, which isn't part of this system's
    # audio stack (sysctl's own DEPS=(... wpctl ...) has no pamixer).
    local target="$1" line pct muted
    line=$(wpctl get-volume "$target" 2>/dev/null) || { echo "0 0"; return 1; }
    pct=$(awk '{printf "%d", $2 * 100 + 0.5}' <<< "$line")
    (( pct > 100 )) && pct=100
    (( pct < 0 )) && pct=0
    [[ "$line" == *MUTED* ]] && muted=1 || muted=0
    echo "$pct $muted"
}

function vvolume() {
    local vol muted icon msg
    if ! command -v wpctl &> /dev/null; then
        echo "󰝟 No tool"; return
    fi
    read -r vol muted < <(_wpctl_pct_muted @DEFAULT_AUDIO_SINK@)
    if [[ "$muted" == "1" || "$vol" -eq 0 ]]; then
        icon="󰝟"; msg="Muted"
    elif [[ "$vol" -ge 100 ]]; then icon="󰶬"; msg="${vol}%"
    elif [[ "$vol" -ge 75 ]]; then icon="󰕾"; msg="${vol}%"
    elif [[ "$vol" -ge 25 ]]; then icon="󰖀"; msg="${vol}%"
else icon="󰕿"; msg="${vol}%"; fi
    echo "${icon} ${msg}"
}

function vvolume_raw() {
    local vol_float
    vol_float=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2}')
    # Pass the float to awk, then tell awk to multiply it by 100
    echo "$vol_float" | awk '{printf "%d", $1 * 100}'
}

function mmicrophone() {
    local vol muted icon msg
    if ! command -v wpctl &> /dev/null; then
        echo " No tool"; return
    fi
    read -r vol muted < <(_wpctl_pct_muted @DEFAULT_AUDIO_SOURCE@)
    if [[ "$muted" == "0" && "$vol" -gt 0 ]]; then
        icon=""; msg="${vol}%"
    else
        icon=""; msg="Muted"
    fi
    echo "${icon} ${msg}"
}

function mmicrophone_raw() {
    local mic_float
    mic_float=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print $2}')
    # Pass the float to awk, then tell awk to multiply it by 100
    echo "$mic_float" | awk '{printf "%d", $1 * 100}'
}

function bbrightness() {
    local brightness_raw max_brightness brightness icon backlight_dir

    # Fix: Handle multiple backlight controllers by picking the first one found
    backlight_dir=$(find /sys/class/backlight/ -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)

    if [[ -z "$backlight_dir" ]]; then
        echo "󰛨 N/A"
        return
    fi

    brightness_raw=$(cat "$backlight_dir/brightness" 2>/dev/null || echo "0")
    max_brightness=$(cat "$backlight_dir/max_brightness" 2>/dev/null || echo "100")

    [[ -z "$brightness_raw" || -z "$max_brightness" || "$max_brightness" -eq 0 ]] && brightness=0 || \
        brightness=$(( (brightness_raw * 100 + max_brightness / 2) / max_brightness ))

    if   [[ "$brightness" -ge 100 ]]; then icon="󰛨"
    elif [[ "$brightness" -ge 90 ]];  then icon="󱩖"
    elif [[ "$brightness" -ge 80 ]];  then icon="󱩖"
    elif [[ "$brightness" -ge 70 ]];  then icon="󱩕"
    elif [[ "$brightness" -ge 60 ]];  then icon="󱩔"
    elif [[ "$brightness" -ge 50 ]];  then icon="󱩓"
    elif [[ "$brightness" -ge 40 ]];  then icon="󱩒"
    elif [[ "$brightness" -ge 30 ]];  then icon="󱩑"
    elif [[ "$brightness" -ge 20 ]];  then icon="󱩐"
    elif [[ "$brightness" -ge 10 ]];  then icon="󱩏"
    else                                icon="󱩎"
    fi

    echo "${icon} ${brightness}%"
}

function bbrightness_raw() {
    # brightnessctl -m outputs a comma-separated machine-readable string.
    # The 4th field is the percentage (e.g., "50%"). We strip the '%' sign.
    brightnessctl -m | awk -F, '{print $4}' | tr -d '%'
}

function ggpu() {
    local usage="" temp=""
    local intel_card="/sys/class/drm/card1"

    # 1. Try NVIDIA
    if command -v nvidia-smi &> /dev/null; then
        if dgpu_out=$(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits 2>/dev/null); then
            usage=$(echo "$dgpu_out" | awk -F', ' '{print $1}' | xargs)
            temp=$(echo "$dgpu_out" | awk -F', ' '{print $2}' | xargs)
            if [[ -n "$usage" ]]; then
                echo "󰢮 ${usage}% (${temp}°C)"
                return
            fi
        fi
    fi

    # 2. Get Temperature (iGPU shares CPU die)
    # Check thermal_zone (most reliable on laptops)
    if [[ -f /sys/class/thermal/thermal_zone0/temp ]]; then
        temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
        temp=$(( temp / 1000 ))
    fi

    # 3. Intel iGPU Logic (Targeting card1)
    if [[ -d "$intel_card" ]]; then
        local cur max
        cur=$(cat "$intel_card/gt_cur_freq_mhz" 2>/dev/null || echo "0")
        max=$(cat "$intel_card/gt_max_freq_mhz" 2>/dev/null || echo "0")

        if [[ "${max:-0}" -gt 0 ]]; then
            usage=$(( ${cur:-0} * 100 / ${max:-0} ))
            echo "󰢮 iGPU: ${usage}% (${temp:-?}°C)"
            return
        fi
    fi

    # 4. Fallback
    if lspci 2>/dev/null | grep -iq 'vga.*intel'; then
        echo "󰢮 Intel iGPU (${temp:-?}°C)"
    else
        echo "󰢮 No GPU"
    fi
}

function kkernel() {
    echo "󰌽 $(uname -r 2>/dev/null || echo "Unknown")"
}

function updates() {
    if command -v checkupdates &> /dev/null; then
        local count
        count=$(checkupdates 2>/dev/null | wc -l)
        [[ "$count" -gt 0 ]] && echo "󰚰 ${count}"
    fi
}

function weather() {
    local weather_data icon code temp

    # 1. Fetch data. We use %k and %t separately to avoid splitting issues.
    # We use || true to ensure 'set -e' doesn't kill the script if the net is down.
    code=$(curl -4 -sL --max-time 3 "wttr.in?format=%k" 2>/dev/null || echo "")
    temp=$(curl -4 -sL --max-time 3 "wttr.in?format=%t" 2>/dev/null || echo "")

    # 2. If we have no temperature, exit silently
    [[ -z "$temp" ]] && return

    # 3. Clean the temperature string (remove + and spaces)
    temp=$(echo "$temp" | tr -d '+ ')

    # 4. Map codes to Nerd Font Icons
    case "$code" in
        113) icon="󰖙" ;; # Sunny
        116) icon="󰖕" ;; # Partly Cloudy
        119|122) icon="󰖐" ;; # Cloudy
        143|248|260) icon="󰖑" ;; # Fog
        176|263|266|293|296|299|302|305|308) icon="󰖗" ;; # Rain
        200|386|389|392|395) icon="󰙾" ;; # Storm
        179|182|185|227|230|323|326|329|332|335|338) icon="󰼶" ;; # Snow
        *) icon="󰖐" ;; # Default Cloud
    esac

    echo "${icon} ${temp}"
}

function network_ips() {
    local priv_ip pub_ip
    priv_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' | head -n1 || echo "N/A")
    pub_ip=$(curl -4 -s --max-time 2 ifconfig.me 2>/dev/null || echo "Offline")
    echo "󰩟 ${priv_ip} | 󰩠 ${pub_ip}"
}

function all_stats() {
    local u=$(updates)
    local w=$(weather)
    [[ -n "$u" ]] && echo -n "$u | "
    [[ -n "$w" ]] && echo -n "$w | "
    echo "$(is_media) | $(cpu_load) | $(ggpu) | $(memory_usage) | $(disk_usage) | $(vvolume) | $(bbattery) | $(network_ips) | $(wifi_status) | $(date_time)"
}

