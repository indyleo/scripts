#!/usr/bin/env bash
# Drop-in dmenu replacement backed by the Quickshell bar's Dmenu picker.
#
# Usage (same idea as dmenu):
#   some-command | qsdmenu -p "Prompt:"
#   choice=$(printf 'yes\nno\n' | qsdmenu -p "Confirm:")
#
# Multi-select: Ctrl+click any number of items in the picker (no flag
# needed here - it's a gesture in the UI itself), then press Enter. Each
# selected item comes back on its own line, so a caller that wants to
# handle multiple choices should read line-by-line rather than assume a
# single value, e.g.:
#   qsdmenu -p "Pick files:" < filelist.txt | while IFS= read -r f; do
#       echo "chose: $f"
#   done
# A plain click (no Ctrl) still submits immediately with just that one
# item, so single-select callers work exactly as before.
#
# Password entry: -password (or -P) masks what's typed, e.g.
#   echo "" | qsdmenu -password -p "Password:"
# (feed it an empty line so the picker is just an input box; whatever is typed
# comes back on stdout).
#
# Only -p (prompt) and -password/-P are honoured; other dmenu flags are
# accepted and ignored so existing scripts don't break outright. Exit status
# is 0 with the choice(s) on stdout, or 1 with nothing on stdout if cancelled
# (Escape) or nothing was selected.

prompt="run"
password=0
while [ $# -gt 0 ]; do
    case "$1" in
        # (a trailing -p with no value must not loop forever on a failed shift)
        -p) prompt="${2-}"; shift; [ $# -gt 0 ] && shift ;;
        -P|-password) password=1; shift ;;
        *) shift ;;
    esac
done

# The IPC call only carries <infile> <outfifo> <prompt>, so the mask flag rides
# along as a leading U+0001 on the prompt; Dmenu.qml strips it and masks input.
[ "$password" = 1 ] && prompt=$'\x01'"$prompt"

tmpdir=$(mktemp -d)
infile="$tmpdir/in"
outfifo="$tmpdir/out"
cleanup() { rm -rf "$tmpdir"; }
trap cleanup EXIT

cat > "$infile"
mkfifo "$outfifo"

qs ipc call pick dmenu "$infile" "$outfifo" "$prompt" || exit 1

result=$(cat "$outfifo")

if [ -n "$result" ]; then
    printf '%s\n' "$result"
    exit 0
else
    exit 1
fi
