#!/usr/bin/env bash
# =====================================
# Archive Utility Script
# Supports: extract | archive
# =====================================

set -e

function usage() {
    cat <<'EOF'
Usage:
  archives extract <archive_file>
  archives archive <archive_name> <file1> [file2 ... fileN]

Description:
  A simple archive utility to extract or create common archive formats.

Supported extraction formats:
  .tar.bz2, .tar.gz, .bz2, .rar, .gz, .tar, .tbz2, .tgz, .zip, .Z, .7z, .deb, .tar.xz, .tar.zst

Supported archive formats:
  .tar.gz, .zip, .rar

Examples:
  archives extract data.tar.gz
  archives archive backup.zip file1.txt file2.txt
EOF
    exit 1
}

# --- Extraction function ---
function extract() {
    local file="$1"
    if [[ -z "$file" ]]; then
        echo "Error: No file specified for extraction."
        usage
    fi

    if [[ ! -f "$file" ]]; then
        echo "Error: '$file' is not a valid file."
        exit 1
    fi

    # NOTE: .gz/.bz2/.Z are single-stream compressors, not archives - they
    # never have a "top-level directory" to detect, and the code below that
    # tried to synthesize one (`dir_name="${base_name%.*}"`, e.g.
    # "sample.txt.gz" -> "sample.txt") collides head-on with the original
    # uncompressed file that almost always sits right next to its .gz/.bz2/.Z
    # copy - mkdir fails because a *file* of that name already exists.
    # These formats always contain exactly one member, so just decompress
    # them in place, matching what gunzip/bunzip2/uncompress do by default.
    case "$file" in
        # IMPORTANT: .tar.gz/.tgz/.tar.bz2/.tbz2/.tar.xz/.tar.zst must fall
        # through to the real archive-handling logic below, not the
        # single-stream case underneath - a bare `*.gz)` pattern would also
        # match "project.tar.gz" and try to gunzip it into "project.tar"
        # instead of actually extracting the tarball.
        *.tar.gz|*.tar.bz2|*.tar.xz|*.tar.zst|*.tgz|*.tbz2) : ;;
        *.gz)
            if gunzip -k -- "$file"; then
                echo "✅ Extracted: ${file%.gz}"
            fi
            return
            ;;
        *.bz2)
            if bunzip2 -k -- "$file"; then
                echo "✅ Extracted: ${file%.bz2}"
            fi
            return
            ;;
        *.Z)
            if uncompress -c -- "$file" > "${file%.Z}"; then
                echo "✅ Extracted: ${file%.Z}"
            fi
            return
            ;;
    esac

    # Determine a target directory
    local base_name
    base_name=$(basename "$file")
    local dir_name="${base_name%.*}"  # remove extension, may need tweak for double extensions

    # Handle double extensions like .tar.gz, .tar.bz2, .tar.xz, .tar.zst
    if [[ "$file" =~ \.tar\.gz$ || "$file" =~ \.tar\.bz2$ || "$file" =~ \.tar\.xz$ || "$file" =~ \.tar\.zst$ ]]; then
        dir_name="${base_name%.*.*}"
    elif [[ "$file" =~ \.tbz2$ || "$file" =~ \.tgz$ ]]; then
        dir_name="${base_name%.*.*}"
    fi

    # Check if archive contents already have a top-level directory
    local temp_dir
    temp_dir=$(mktemp -d)
    case "$file" in
        *.tar.bz2|*.tar.gz|*.tar|*.tbz2|*.tgz|*.tar.xz|*.tar.zst)
            tar -tf "$file" | head -1 > "$temp_dir/first_entry.txt"
            ;;
        *.zip)
            unzip -l "$file" | awk 'NR>3 {print $4}' | head -1 > "$temp_dir/first_entry.txt"
            ;;
        *.7z)
            7z l "$file" | awk '/^----/{flag=1;next} /^----/{flag=0} flag {print $6}' | head -1 > "$temp_dir/first_entry.txt"
            ;;
        *.rar)
            unrar lb "$file" | head -1 > "$temp_dir/first_entry.txt"
            ;;
        *.deb)
            # .deb (ar) archives are flat (debian-binary, control.tar.*,
            # data.tar.*) - there's never a shared top-level directory, so
            # always take the "create a wrapper dir" branch below. Leaving
            # first_entry.txt unwritten already achieves that (empty
            # first_entry fails the `-d` test), this just documents why.
            ;;
        *)
            echo "Warning: Cannot determine archive structure for '$file'"
            ;;
    esac

    local first_entry_raw=""
    [[ -f "$temp_dir/first_entry.txt" ]] && first_entry_raw=$(head -1 "$temp_dir/first_entry.txt")

    rm -rf "$temp_dir"

    # NOTE: this used to check `[[ ! -d "$first_entry" ]]` - i.e. whether a
    # directory of that name already exists ON DISK. That's the wrong
    # question: right before extracting, that directory almost never exists
    # yet (that's the point of extracting!), so this always concluded "no
    # wrapper directory" and created one anyway - for a well-formed archive
    # like "proj.tar.gz" containing "proj/inner/file.txt", that meant
    # extracting into "proj/" on top of an archive that already wraps
    # everything in "proj/", producing double-nested "proj/proj/inner/...".
    # What actually matters is the ARCHIVE'S OWN structure: does its first
    # entry live inside a subdirectory (contains a "/"), or is it a loose
    # file at the archive root?
    if [[ "$first_entry_raw" != */* ]]; then
        mkdir -p "$dir_name"
        case "$file" in
            *.tar.bz2) tar xjf "$file" -C "$dir_name" ;;
            *.tar.gz)  tar xzf "$file" -C "$dir_name" ;;
            *.rar)     unrar x "$file" "$dir_name/" ;;
            *.tar)     tar xf "$file" -C "$dir_name" ;;
            *.tbz2)    tar xjf "$file" -C "$dir_name" ;;
            *.tgz)     tar xzf "$file" -C "$dir_name" ;;
            *.zip)     unzip "$file" -d "$dir_name" ;;
            *.7z)      7z x "$file" -o"$dir_name" ;;
            *.deb)
                # NOTE: `ar` has no `-C`/target-directory flag (unlike tar/
                # unzip) - passing one is a silent no-op at best or an
                # "invalid option" error at worst. `ar` always extracts to
                # the current directory, so cd into the target instead and
                # resolve the source to an absolute path first, since it's
                # relative to the directory we're about to leave.
                local abs_file
                abs_file=$(realpath "$file")
                (cd "$dir_name" && ar x "$abs_file")
                ;;
            *.tar.xz)  tar xf "$file" -C "$dir_name" ;;
            *.tar.zst) unzstd -c "$file" | tar xf - -C "$dir_name" ;;
            *)         echo "Error: '$file' cannot be extracted via this script." ;;
        esac
        echo "✅ Extracted to directory: $dir_name"
    else
        # Archive already has a top-level directory
        case "$file" in
            *.tar.bz2) tar xjf "$file" ;;
            *.tar.gz)  tar xzf "$file" ;;
            *.rar)     unrar x "$file" ;;
            *.tar)     tar xf "$file" ;;
            *.tbz2)    tar xjf "$file" ;;
            *.tgz)     tar xzf "$file" ;;
            *.zip)     unzip "$file" ;;
            *.7z)      7z x "$file" ;;
            *.deb)     ar x "$file" ;;
            *.tar.xz)  tar xf "$file" ;;
            *.tar.zst) unzstd "$file" ;;
        esac
        echo "✅ Extracted archive contents (already in top-level directory)"
    fi
}

# --- Archiving function ---
function archive() {
    local archive_name="$1"
    shift
    local files=("$@")

    if [[ -z "$archive_name" || "${#files[@]}" -lt 1 ]]; then
        echo "Error: Missing archive name or files."
        usage
    fi

    if [[ -e "$archive_name" ]]; then
        echo "Error: Archive '$archive_name' already exists."
        exit 1
    fi

    case "$archive_name" in
        *.tar.gz)
            tar -czf "$archive_name" "${files[@]}"
            ;;
        *.zip)
            zip -r "$archive_name" "${files[@]}"
            ;;
        *.rar)
            if command -v rar > /dev/null; then
                rar a "$archive_name" "${files[@]}"
            else
                echo "Error: 'rar' command not found. Please install RAR to create .rar archives."
                exit 1
            fi
            ;;
        *)
            echo "Error: Unsupported archive format."
            echo "Supported: .tar.gz, .zip, .rar"
            exit 1
            ;;
    esac

    echo "✅ Archive created: $archive_name"
}

# --- Main dispatcher ---
if [[ $# -lt 1 ]]; then
    usage
fi

command="$1"
shift

case "$command" in
    extract) extract "$@" ;;
    archive) archive "$@" ;;
    help|--help|-h) usage ;;
    *)
        echo "Error: Unknown command '$command'"
        usage
        ;;
esac