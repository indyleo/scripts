#!/usr/bin/env bash
# wifi — WiFi manager using qsdmenu (the Quickshell picker) + nmcli
#
# qsdmenu only understands -p (prompt) and -password (mask the input), so the
# old rofi flags (-dmenu, -theme-str, -i, ...) are gone: window size and
# case-insensitive filtering are fixed by Dmenu.qml. Text typed into the picker
# that matches no row is returned as-is, which the SSID/password prompts and
# the "type an SSID" fallback below rely on.

DIVIDER="──────────────────────"
TOGGLE_ON="󰤭  Disable WiFi"
TOGGLE_OFF="󰤨  Enable WiFi"
DISCONNECT_ITEM="󰖰  Disconnect"
MANUAL_ITEM="󰐥  Manual / Hidden SSID"
SAVED_TAG=" 󰆓"

MENU()        { qsdmenu -p "$1"; }
# Text prompts: feed the picker one empty line so it behaves as a plain input box.
# (Escape and an empty Enter both come back as empty output.)
PROMPT()      { echo "" | qsdmenu -p "$1"; }
PROMPT_PASS() { echo "" | qsdmenu -password -p "$1"; }

# Resolve the wifi device once, used for disconnect/status actions
wifi_dev() {
    nmcli -t -f DEVICE,TYPE device | awk -F: '$2=="wifi"{print $1; exit}'
}

# connect_new SSID [PASSWORD] [hidden]
# Connects to a network that has no saved profile. "hidden" is needed for SSIDs
# that don't broadcast, otherwise nmcli only looks in the scan list and gives up.
connect_new() {
    local ssid="$1" password="${2:-}" hidden="${3:-}"
    local args=(device wifi connect "$ssid")
    [[ -n "$password" ]] && args+=(password "$password")
    [[ -n "$hidden" ]] && args+=(hidden yes)
    if nmcli "${args[@]}"; then
        notify-send "WiFi" "Connected to $ssid" --icon=network-wireless
    else
        notify-send "WiFi" "Failed to connect to $ssid" --icon=network-wireless-offline
    fi
}

wifi_status=$(nmcli radio wifi)

if [[ "$wifi_status" == "disabled" ]]; then
    choice=$(printf '%s\n%s\n' "$TOGGLE_OFF" "$DIVIDER" | MENU "WiFi (disabled):")
    if [[ "$choice" == "$TOGGLE_OFF" ]]; then
        nmcli radio wifi on
    fi
    exit 0
fi

connected_ssid=$(nmcli -t -f active,ssid dev wifi | awk -F: '/^yes/{print $2}')

# Saved (known) wifi connection profile names, one per line, full names (spaces intact)
declare -A is_saved=()
while IFS= read -r name; do
    [[ -n "$name" ]] && is_saved["$name"]=1
done < <(nmcli -t -f NAME,TYPE connection show | awk -F: '$NF=="802-11-wireless"{NF--; print}' OFS=:)

# Parse live scan results with -t (colon-delimited, handles spaces in SSIDs)
declare -A signal_of=() security_of=() inuse_of=() seen=()
order=()
while IFS=: read -r inuse ssid security signal; do
    [[ -z "$ssid" ]] && continue
    [[ "$inuse" == "*" ]] && inuse_of["$ssid"]=1
    if [[ -z "${signal_of[$ssid]:-}" || "${signal:-0}" -gt "${signal_of[$ssid]}" ]]; then
        signal_of["$ssid"]="$signal"
        security_of["$ssid"]="$security"
    fi
    if [[ -z "${seen[$ssid]:-}" ]]; then
        order+=("$ssid")
        seen["$ssid"]=1
    fi
done < <(nmcli -t -f IN-USE,SSID,SECURITY,SIGNAL device wifi list 2>/dev/null)

# SSID column is as wide as the longest SSID (802.11 caps them at 32), so the
# security/saved columns still fit inside the picker's fixed-width window.
ssid_w=12
for ssid in "${order[@]}"; do
    (( ${#ssid} > ssid_w )) && ssid_w=${#ssid}
done
(( ssid_w > 32 )) && ssid_w=32

# Build display lines + a line->ssid lookup so we never re-parse text for the ssid
declare -A ssid_by_line=()
display_lines=()
for ssid in "${order[@]}"; do
    sec="${security_of[$ssid]}"
    [[ -z "$sec" || "$sec" == "--" ]] && sec_label="open" || sec_label="$sec"
    prefix="  "
    [[ -n "${inuse_of[$ssid]:-}" ]] && prefix="▶ "
    saved_tag=""
    [[ -n "${is_saved[$ssid]:-}" ]] && saved_tag="$SAVED_TAG"
    line=$(printf "%s%-*s %3s%%  %s%s" "$prefix" "$ssid_w" "$ssid" "${signal_of[$ssid]:-0}" "$sec_label" "$saved_tag")
    display_lines+=("$line")
    ssid_by_line["$line"]="$ssid"
done

menu=$(printf '%s\n' "$TOGGLE_ON" "$DIVIDER" "${display_lines[@]}" "$DIVIDER" "$DISCONNECT_ITEM" "$MANUAL_ITEM")

choice=$(printf '%s\n' "$menu" | MENU "WiFi:")
# Ctrl+click in the picker multi-selects and returns one item per line; we only
# ever act on one, so take the first.
choice="${choice%%$'\n'*}"

[[ -z "$choice" ]] && exit 0

case "$choice" in
    "$TOGGLE_ON")
        nmcli radio wifi off
        notify-send "WiFi" "WiFi disabled" --icon=network-wireless-offline
        ;;

    "$DISCONNECT_ITEM")
        dev=$(wifi_dev)
        nmcli device disconnect "$dev" 2>/dev/null
        notify-send "WiFi" "Disconnected" --icon=network-wireless-offline
        ;;

    "$MANUAL_ITEM")
        ssid=$(PROMPT "SSID:")
        [[ -z "$ssid" ]] && exit 0
        # Blank password = open network (qsdmenu can't tell blank from Escape)
        password=$(PROMPT_PASS "Password:")
        connect_new "$ssid" "$password" hidden
        ;;

    "$DIVIDER") exit 0 ;;

    *)
        ssid="${ssid_by_line[$choice]:-}"

        # Not one of our rows, so the user typed an SSID into the picker and hit
        # Enter: trim it (and a stray ▶ marker) and use it as-is.
        if [[ -z "$ssid" ]]; then
            ssid="${choice#▶ }"
            ssid="${ssid#"${ssid%%[![:space:]]*}"}"
            ssid="${ssid%"${ssid##*[![:space:]]}"}"
            [[ -z "$ssid" ]] && exit 0

            # Not in the scan and not saved: treat it like a hidden network
            if [[ -z "${seen[$ssid]:-}" && -z "${is_saved[$ssid]:-}" ]]; then
                password=$(PROMPT_PASS "Password ($ssid):")
                [[ -z "$password" ]] && exit 0
                connect_new "$ssid" "$password" hidden
                exit 0
            fi
        fi

        # Selecting the network you're already on disconnects it (toggle behavior)
        if [[ -n "$connected_ssid" && "$ssid" == "$connected_ssid" ]]; then
            dev=$(wifi_dev)
            nmcli device disconnect "$dev" 2>/dev/null
            notify-send "WiFi" "Disconnected from $ssid" --icon=network-wireless-offline
            exit 0
        fi

        # Selecting a saved network connects instantly, no password prompt
        if [[ -n "${is_saved[$ssid]:-}" ]]; then
            dev=$(wifi_dev)
            err=$(nmcli connection up "$ssid" ifname "$dev" 2>&1)
            rc=$?
            if [[ $rc -ne 0 && "$err" == *"interface name"* ]]; then
                # Stale connection.interface-name binding on the saved profile — clear it and retry once
                nmcli connection modify "$ssid" connection.interface-name "" 2>/dev/null
                err=$(nmcli connection up "$ssid" ifname "$dev" 2>&1)
                rc=$?
            fi
            if [[ $rc -eq 0 ]]; then
                notify-send "WiFi" "Connected to $ssid" --icon=network-wireless
            else
                notify-send "WiFi" "Failed to connect to $ssid" --icon=network-wireless-offline
            fi
        else
            security="${security_of[$ssid]}"
            if [[ -z "$security" || "$security" == "--" ]]; then
                connect_new "$ssid"
            else
                password=$(PROMPT_PASS "Password ($ssid):")
                [[ -z "$password" ]] && exit 0
                connect_new "$ssid" "$password"
            fi
        fi
        ;;
esac
