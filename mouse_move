#!/usr/bin/env bash
#
# mouse_move — Toggleable keyboard-driven "Mouse Mode" for Linux
# Works on both X11 and Wayland because it never talks to the display
# server: input is read directly from the raw evdev device
# (/dev/input/eventX) and mouse actions are injected with `ydotool`,
# which writes through the uinput kernel driver (compositor-agnostic).
#
# IMPORTANT: while Mouse Mode is ON, the keys h/j/k/l/f/d/Space/g/s are
# grabbed *exclusively* (EVIOCGRAB) by a tiny helper program compiled from
# the embedded C source below. That helper re-emits every OTHER key
# through a virtual passthrough keyboard, so normal typing keeps
# working everywhere — only those keys stop reaching applications
# while active, since they're being consumed as mouse commands.
#
# Run once to turn Mouse Mode ON (background listener starts).
# Run again to turn it OFF (listener is killed, lock file removed,
# grab released, and normal key delivery resumes automatically).
#
# Keys while active:
#   h / j / k / l  -> move mouse left / down / up / right
#   f              -> left click   (ydotool click 0xC0)
#   d              -> right click  (ydotool click 0xC1)
#   Space          -> middle click (ydotool click 0xC2)
#   g              -> left button DOWN (ydotool click 0x40)  # for drag
#   s              -> left button UP   (ydotool click 0x80)  # for drop
#
# Requirements: ydotool, ydotoold, a C compiler (gcc or cc), and your
# user must be in the "input" group (for /dev/uinput and
# /dev/input/eventX access).
#
set -uo pipefail

# ---------------------------------------------------------------------------
# Configuration (override via environment variables if you like)
# ---------------------------------------------------------------------------
PID_FILE="/tmp/ydotool_mouse_mode.pid"
LOG_FILE="/tmp/ydotool_mouse_mode.log"
MOVE_STEP="${MOUSE_MODE_STEP:-20}"                  # pixels per keypress
KEYBOARD_EVENT_DEVICE="${KEYBOARD_EVENT_DEVICE:-}"  # e.g. /dev/input/event3
GRABBER_SRC="/tmp/.mouse_mode_grabber.c"
GRABBER_BIN="/tmp/.mouse_mode_grabber"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

function notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send -i "input-mouse" "Mouse Mode" "$1"
}

function die() {
    echo "ERROR: $1" >&2
    exit 1
}

function check_command() {
    command -v "$1" >/dev/null 2>&1 || die "'$1' is not installed or not in PATH."
}

# Confirm the user is in the "input" group, which grants access to
# /dev/uinput (needed by ydotoold and our grabber) and
# /dev/input/eventX (needed by our grabber to read the keyboard).
function check_input_group() {
    if ! id -nG | tr ' ' '\n' | grep -qx "input"; then
        cat >&2 <<EOF
You are not in the 'input' group, so /dev/uinput and
/dev/input/eventX may not be accessible.

Fix it with:
    sudo usermod -aG input "$(id -un)"

Then log out and back in (group membership only applies to new
sessions) and re-run this script.
EOF
        exit 1
    fi
}

function check_uinput_perms() {
    [ -e /dev/uinput ] || die "/dev/uinput does not exist — is the uinput kernel module loaded? Try: sudo modprobe uinput"
    [ -w /dev/uinput ] || die "/dev/uinput is not writable by $(id -un). Check its group is 'input' and that you're a member."
}

function ensure_ydotoold() {
    check_command ydotool
    check_command ydotoold

    export YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-${XDG_RUNTIME_DIR:-/tmp}/.ydotool_socket}"

    if ! pgrep -x ydotoold >/dev/null 2>&1; then
        echo "Starting ydotoold..."
        nohup ydotoold --socket-path="$YDOTOOL_SOCKET" >>"$LOG_FILE" 2>&1 &
        disown

        for _ in $(seq 1 30); do
            [ -S "$YDOTOOL_SOCKET" ] && break
            sleep 0.1
        done
        [ -S "$YDOTOOL_SOCKET" ] || die "ydotoold did not create its socket at $YDOTOOL_SOCKET"
    fi
}

# Auto-detect a keyboard's /dev/input/eventX node, unless the user
# already set KEYBOARD_EVENT_DEVICE.
#
# We no longer require an exact EV bitmask match (e.g. "120013"): that
# bitmask depends on which optional capabilities (LEDs, autorepeat,
# misc scancodes) the specific keyboard reports, so it varies from
# device to device and caused real keyboards to go undetected. Instead
# we require the EV_KEY bit to be set and prefer devices whose kernel
# "Handlers" line contains a "kbd" handler (the standard marker for a
# keyboard-class input device), while skipping obvious non-keyboard
# nodes such as power/sleep buttons and video-bus toggles that also
# expose a "kbd" handler but have almost no keys.
function find_keyboard_device() {
    if [ -n "$KEYBOARD_EVENT_DEVICE" ]; then
        echo "$KEYBOARD_EVENT_DEVICE"
        return
    fi

    awk '
        function is_keyboard_ev(ev,    n) {
            # EV is a hex bitmask; bit 1 (value 2) is EV_KEY.
            n = strtonum("0x" ev)
            return and(n, 2) == 2
        }
        /^N: Name=/ { name=$0; sub(/^N: Name=/, "", name); gsub(/"/, "", name) }
        /^H: Handlers=/ { handlers=$0 }
        /^B: EV=/ {
            ev=$0
            sub(/^B: EV=/, "", ev)
            has_kbd_handler = (handlers ~ /(^|[[:space:]])kbd[0-9]*([[:space:]]|$)/)
            skip = (name ~ /Power Button|Sleep Button|Video Bus|Consumer Control/)
            if (is_keyboard_ev(ev) && has_kbd_handler && !skip) {
                match(handlers, /event[0-9]+/)
                if (RSTART) {
                    print "/dev/input/" substr(handlers, RSTART, RLENGTH)
                    exit
                }
            }
        }
    ' /proc/bus/input/devices
}

# ---------------------------------------------------------------------------
# Embedded C helper: grabs the keyboard exclusively, forwards every key
# EXCEPT h/j/k/l/f/d/Space/g/s to a virtual passthrough keyboard (so
# normal typing keeps working), and dispatches ydotool for the mapped keys.
# Compiled once and cached at $GRABBER_BIN.
# ---------------------------------------------------------------------------
function write_grabber_source() {
    cat > "$1" <<'EOF_C'
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <string.h>
#include <signal.h>
#include <sys/ioctl.h>
#include <sys/wait.h>
#include <linux/uinput.h>
#include <linux/input.h>

static int dev_fd = -1;
static int uinput_fd = -1;
/* Tracks whether we've told ydotool to press the left button down (the
 * 'g' key) without a matching 's' (button up) yet. If Mouse Mode gets
 * toggled off (or the process is killed) while a drag is in progress,
 * the virtual mouse button would otherwise stay stuck down forever,
 * since ydotoold's virtual pointer is a separate, persistent uinput
 * device that outlives this process. */
static volatile sig_atomic_t left_button_held = 0;

static void release_stuck_button(void) {
    if (left_button_held) {
        char *a[] = {"ydotool", "click", "0x80", NULL};
        pid_t pid = fork();
        if (pid == 0) {
            execvp("ydotool", a);
            _exit(127);
        } else if (pid > 0) {
            waitpid(pid, NULL, 0); /* make sure it actually runs before we exit */
        }
        left_button_held = 0;
    }
}

static void cleanup_and_exit(int sig) {
    (void)sig;
release_stuck_button();
    if (uinput_fd >= 0) {
        ioctl(uinput_fd, UI_DEV_DESTROY);
        close(uinput_fd);
    }
    if (dev_fd >= 0) {
        ioctl(dev_fd, EVIOCGRAB, 0);
        close(dev_fd);
    }
    _exit(0);
}

/* Run ydotool with the given argv in a child process, don't wait
 * (SIGCHLD is ignored so children are auto-reaped, no zombies). */
static void run_ydotool(char *const argv[]) {
    pid_t pid = fork();
    if (pid == 0) {
        execvp("ydotool", argv);
        _exit(127); /* only reached if exec fails */
    }
}

int main(int argc, char **argv) {
    if (argc < 3) {
        fprintf(stderr, "usage: %s <event-device> <move-step>\n", argv[0]);
        return 1;
    }
    const char *devpath = argv[1];
    int step = atoi(argv[2]);
    char step_pos[16], step_neg[16];
    snprintf(step_pos, sizeof(step_pos), "%d", step);
    snprintf(step_neg, sizeof(step_neg), "-%d", step);

    signal(SIGTERM, cleanup_and_exit);
    signal(SIGINT, cleanup_and_exit);
    signal(SIGHUP, cleanup_and_exit);  /* controlling terminal closing shouldn't leave the grab/click stuck */
    signal(SIGCHLD, SIG_IGN);

    dev_fd = open(devpath, O_RDONLY);
    if (dev_fd < 0) { perror("open device"); return 1; }

    if (ioctl(dev_fd, EVIOCGRAB, 1) < 0) {
        perror("EVIOCGRAB (exclusive grab failed)");
        close(dev_fd);
        dev_fd = -1;
        return 1;
    }

    uinput_fd = open("/dev/uinput", O_WRONLY | O_NONBLOCK);
    if (uinput_fd < 0) {
        perror("open /dev/uinput");
        ioctl(dev_fd, EVIOCGRAB, 0);
        close(dev_fd);
        dev_fd = -1;
        return 1;
    }

    if (ioctl(uinput_fd, UI_SET_EVBIT, EV_KEY) < 0 ||
        ioctl(uinput_fd, UI_SET_EVBIT, EV_SYN) < 0 ||
        ioctl(uinput_fd, UI_SET_EVBIT, EV_MSC) < 0 ||
        ioctl(uinput_fd, UI_SET_MSCBIT, MSC_SCAN) < 0) {
        perror("configuring uinput device");
        cleanup_and_exit(0);
    }

    for (int i = 0; i < KEY_MAX; i++) {
        if (ioctl(uinput_fd, UI_SET_KEYBIT, i) < 0) {
            perror("UI_SET_KEYBIT");
            cleanup_and_exit(0);
        }
    }

    struct uinput_setup usetup;
    memset(&usetup, 0, sizeof(usetup));
    usetup.id.bustype = BUS_USB;
    usetup.id.vendor = 0x1d6b;
    usetup.id.product = 0x0100;
    strncpy(usetup.name, "mouse-mode-passthrough-kbd", sizeof(usetup.name) - 1);

    if (ioctl(uinput_fd, UI_DEV_SETUP, &usetup) < 0) {
        perror("UI_DEV_SETUP");
        cleanup_and_exit(0);
    }

    if (ioctl(uinput_fd, UI_DEV_CREATE) < 0) {
        perror("UI_DEV_CREATE");
        cleanup_and_exit(0);
    }

    usleep(200000); /* let udev settle before events start flowing */

    struct input_event ev;
    while (read(dev_fd, &ev, sizeof(ev)) == (ssize_t)sizeof(ev)) {
        if (ev.type == EV_KEY) {
            int swallow = 0;

            switch (ev.code) {
                case KEY_H:
                    swallow = 1;
                    if (ev.value == 1 || ev.value == 2) {
                        char *a[] = {"ydotool", "mousemove", "--", step_neg, "0", NULL};
                        run_ydotool(a);
                    }
                    break;
                case KEY_L:
                    swallow = 1;
                    if (ev.value == 1 || ev.value == 2) {
                        char *a[] = {"ydotool", "mousemove", "--", step_pos, "0", NULL};
                        run_ydotool(a);
                    }
                    break;
                case KEY_K:
                    swallow = 1;
                    if (ev.value == 1 || ev.value == 2) {
                        char *a[] = {"ydotool", "mousemove", "--", "0", step_neg, NULL};
                        run_ydotool(a);
                    }
                    break;
                case KEY_J:
                    swallow = 1;
                    if (ev.value == 1 || ev.value == 2) {
                        char *a[] = {"ydotool", "mousemove", "--", "0", step_pos, NULL};
                        run_ydotool(a);
                    }
                    break;
                case KEY_F:
                    swallow = 1;
                    if (ev.value == 1) {
                        char *a[] = {"ydotool", "click", "0xC0", NULL};
                        run_ydotool(a);
                    }
                    break;
                case KEY_D:
                    swallow = 1;
                    if (ev.value == 1) {
                        char *a[] = {"ydotool", "click", "0xC1", NULL};
                        run_ydotool(a);
                    }
                    break;
                case KEY_SPACE:
                    swallow = 1;
                    if (ev.value == 1) {
                        char *a[] = {"ydotool", "click", "0xC2", NULL};
                        run_ydotool(a);
                    }
                    break;
                case KEY_G:
                    swallow = 1;
                    if (ev.value == 1) {
                        char *a[] = {"ydotool", "click", "0x40", NULL};
                        run_ydotool(a);
                        left_button_held = 1;
                    }
                    break;
                case KEY_S:
                    swallow = 1;
                    if (ev.value == 1) {
                        char *a[] = {"ydotool", "click", "0x80", NULL};
                        run_ydotool(a);
                        left_button_held = 0;
                    }
                    break;
                default:
                    break;
            }

            if (swallow) continue; /* don't forward this key event */
        }

        /* Forward everything else (including SYN/MSC) untouched, so
         * the rest of your keyboard behaves completely normally. */
        struct input_event out = ev;
        out.time.tv_sec = 0;
        out.time.tv_usec = 0;
        write(uinput_fd, &out, sizeof(out));
    }

    cleanup_and_exit(0);
    return 0;
}
EOF_C
}

function ensure_grabber_binary() {
    # Only touch/recompile the cached binary if the source actually
    # changed. Previously the source file was unconditionally
    # rewritten before the "-nt" (newer-than) staleness check, which
    # bumped its mtime on every single invocation and made the check
    # always true — forcing a full recompile every time Mouse Mode was
    # toggled, even when nothing had changed.
    local tmp_src
    tmp_src="$(mktemp)"
    write_grabber_source "$tmp_src"

    if [ ! -f "$GRABBER_SRC" ] || ! cmp -s "$tmp_src" "$GRABBER_SRC"; then
        mv "$tmp_src" "$GRABBER_SRC"
    else
        rm -f "$tmp_src"
    fi

    if [ ! -x "$GRABBER_BIN" ] || [ "$GRABBER_SRC" -nt "$GRABBER_BIN" ]; then
        local cc_bin
        cc_bin="$(command -v cc || command -v gcc || true)"
        [ -n "$cc_bin" ] || die "No C compiler found. Install one (e.g. 'sudo apt install gcc') to build the key-grabbing helper."
        echo "Compiling key-grab helper..."
        "$cc_bin" -O2 -o "$GRABBER_BIN" "$GRABBER_SRC" || die "Failed to compile the grabber helper."
    fi
}

# ---------------------------------------------------------------------------
# Toggle logic
# ---------------------------------------------------------------------------

function is_active() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

function turn_off() {
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"

    if [[ "$pid" =~ ^[0-9]+$ ]]; then
        kill -TERM "$pid" 2>/dev/null || true

        # Give the helper a moment to run its cleanup handler (release
        # the exclusive grab, destroy the passthrough uinput device,
        # and release any stuck-down mouse button) before we return.
        # Without this wait, immediately re-running the script to turn
        # Mouse Mode back on could race the still-exiting old process
        # for the same keyboard grab.
        for _ in $(seq 1 20); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done
        kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null || true
    fi

    rm -f "$PID_FILE"
    notify "Mouse Mode DISABLED"
    echo "Mouse Mode disabled. Normal key delivery restored."
}

function turn_on() {
    ensure_ydotoold
    check_input_group
    check_uinput_perms
    ensure_grabber_binary

    local device
    device="$(find_keyboard_device)"
    [ -n "$device" ] || die "Could not auto-detect a keyboard event device. Set KEYBOARD_EVENT_DEVICE=/dev/input/eventN and retry."
    [ -r "$device" ] || die "$device is not readable by $(id -un) (check the 'input' group membership)."

    "$GRABBER_BIN" "$device" "$MOVE_STEP" >>"$LOG_FILE" 2>&1 &
    local listener_pid=$!
    disown

    # Confirm it actually stayed up (grab or uinput setup can fail fast).
    sleep 0.3
    if ! kill -0 "$listener_pid" 2>/dev/null; then
        die "Grabber helper exited immediately — check $LOG_FILE for details."
    fi

    echo "$listener_pid" > "$PID_FILE"
    notify "Mouse Mode ENABLED"
    echo "Mouse Mode enabled (listening on $device, PID $listener_pid)."
    echo "Keys: h/j/k/l = move, f = L-click, d = R-click, Space = M-click,"
    echo "      g = L-button down, s = L-button up (for dragging)."
    echo "These keys will NOT be typed into text boxes while active."
    echo "Run this script again to disable."
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
function main() {
    if is_active; then
        turn_off
    else
        [ -f "$PID_FILE" ] && rm -f "$PID_FILE"
        turn_on
    fi
}

main "$@"
