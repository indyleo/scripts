# interactive editor
# ---------------------------------------------------------------------------
HELP = """\
list [N [M]]              show events (all, one, or a range)
d N [M] [close]           delete event N (or N..M); 'close' also removes the time gap
t N SECS                  set event N's timestamp
shift N SECS              add SECS to events N..end
scale F [N [M]]           multiply the gaps between events N..M by F
insert N <what>           insert before event N (later events shift to make room):
                            click [button] [press|release]   key NAME [press|release]
                            moveto X Y   move DX DY   scroll DY [DX]
                            type TEXT...   wait CLASS [TIMEOUT]
copy N [M] / paste N      copy a range, paste it before event N
compact [MS]              merge move/scroll bursts (default 10ms), drop no-ops
stats                     summary of the macro
replay [N [M]] [-s SPD]   play (a slice of) the macro right now
undo / redo               step through history
save [file]               write out (default: overwrite the input)
q                         quit (asks twice if there are unsaved changes)
"""


class Editor:
    def __init__(self, path, meta, events):
        self.path, self.meta, self.ev = path, meta, events
        self.undo_stack, self.redo_stack, self.dirty, self.clip = [], [], False, []

    def snap(self):
        self.undo_stack.append(copy.deepcopy(self.ev))
        del self.undo_stack[:-100]
        self.redo_stack.clear()
        self.dirty = True

    def resort(self):
        self.ev.sort(key=lambda e: e["t"])

    def rng(self, toks):
        if not toks:
            raise ValueError("missing event number")
        i = to_int(toks[0], "N")
        j = to_int(toks[1], "M") if len(toks) > 1 else i
        if not 1 <= i <= j <= len(self.ev):
            raise ValueError(f"range must be within 1..{len(self.ev)} (N <= M)")
        return i - 1, j

    def splice(self, idx, rel):
        base = self.ev[idx - 1]["t"] if idx > 0 else 0.0
        dur = max((e["t"] for e in rel), default=0.0)
        for e in self.ev[idx:]:
            e["t"] = round(e["t"] + dur, 4)
        self.ev[idx:idx] = [dict(e, t=round(base + e["t"], 4)) for e in copy.deepcopy(rel)]

    # -- commands ---------------------------------------------------------
    def c_help(self, rest):
        print(HELP)

    def c_list(self, rest):
        toks = rest.split()
        i0, i1 = self.rng(toks) if toks else (0, len(self.ev))
        for n in range(i0, i1):
            print(f"{n + 1:4d}  {fmt_event(self.ev[n])}")

    def c_d(self, rest):
        toks = rest.split()
        close = "close" in toks
        i0, i1 = self.rng([t for t in toks if t != "close"])
        self.snap()
        span = (self.ev[i1 - 1]["t"] - self.ev[i0]["t"]) if close else 0
        gap_after = (self.ev[i1]["t"] - self.ev[i1 - 1]["t"]) if close and i1 < len(self.ev) else 0
        del self.ev[i0:i1]
        if close:
            for e in self.ev[i0:]:
                e["t"] = round(max(0.0, e["t"] - span - gap_after), 4)
        print(f"Deleted {i1 - i0} event(s).")

    def c_t(self, rest):
        tok = rest.split()
        if len(tok) != 2:
            raise ValueError("usage: t N SECS")
        i0, _ = self.rng(tok[:1])
        v = to_float(tok[1], "SECS")
        if v < 0:
            raise ValueError("timestamp must be >= 0")
        self.snap()
        self.ev[i0]["t"] = round(v, 4)
        self.resort()

    def c_shift(self, rest):
        tok = rest.split()
        if len(tok) != 2:
            raise ValueError("usage: shift N SECS")
        i0, _ = self.rng(tok[:1])
        d = to_float(tok[1], "SECS")
        if self.ev[i0]["t"] + d < 0:
            raise ValueError("that would make a timestamp negative")
        self.snap()
        for e in self.ev[i0:]:
            e["t"] = round(e["t"] + d, 4)
        self.resort()

    def c_scale(self, rest):
        tok = rest.split()
        if not tok:
            raise ValueError("usage: scale FACTOR [N [M]]")
        f = to_float(tok[0], "FACTOR")
        if f <= 0:
            raise ValueError("FACTOR must be > 0")
        i0, i1 = self.rng(tok[1:]) if len(tok) > 1 else (0, len(self.ev))
        if len(tok) == 2:
            i1 = len(self.ev)
        self.snap()
        pivot, old_end = self.ev[i0]["t"], self.ev[i1 - 1]["t"]
        for e in self.ev[i0:i1]:
            e["t"] = round(pivot + (e["t"] - pivot) * f, 4)
        delta = (pivot + (old_end - pivot) * f) - old_end
        for e in self.ev[i1:]:
            e["t"] = round(max(0.0, e["t"] + delta), 4)
        self.resort()

    def c_insert(self, rest):
        parts = rest.split(None, 2)
        if len(parts) < 2:
            raise ValueError("usage: insert N click|key|moveto|move|scroll|type|wait ...")
        n = to_int(parts[0], "N")
        if not 1 <= n <= len(self.ev) + 1:
            raise ValueError(f"N must be within 1..{len(self.ev) + 1}")
        kind, arg = parts[1].lower(), (parts[2] if len(parts) > 2 else "")
        toks = arg.split()
        if kind == "click":
            btn = toks[0] if toks else "left"
            if btn not in BTN_MAP:
                raise ValueError(f"button must be one of {', '.join(BTN_MAP)}")
            state = toks[1] if len(toks) > 1 else None
            rel = ([{"t": 0.0, "type": "BUTTON", "button": btn, "state": state}] if state in ("press", "release") else
                   [{"t": 0.0, "type": "BUTTON", "button": btn, "state": "press"},
                    {"t": 0.05, "type": "BUTTON", "button": btn, "state": "release"}])
        elif kind == "key":
            if not toks:
                raise ValueError("usage: insert N key NAME [press|release]")
            code = parse_key(toks[0])
            state = toks[1] if len(toks) > 1 else None
            rel = ([{"t": 0.0, "type": "KEY", "code": code, "state": state}] if state in ("press", "release") else
                   [{"t": 0.0, "type": "KEY", "code": code, "state": "press"},
                    {"t": 0.03, "type": "KEY", "code": code, "state": "release"}])
        elif kind == "moveto" and len(toks) == 2:
            rel = [{"t": 0.0, "type": "MOVETO", "x": int(to_float(toks[0])), "y": int(to_float(toks[1]))}]
        elif kind == "move" and len(toks) == 2:
            rel = [{"t": 0.0, "type": "MOVE", "dx": int(to_float(toks[0])), "dy": int(to_float(toks[1]))}]
        elif kind == "scroll" and toks:
            rel = [{"t": 0.0, "type": "SCROLL", "dy": int(to_float(toks[0])),
                    "dx": int(to_float(toks[1])) if len(toks) > 1 else 0}]
        elif kind == "type" and arg:
            rel = [{"t": 0.0, "type": "TYPE", "text": arg}]
        elif kind == "wait" and toks:
            rel = [{"t": 0.0, "type": "WAIT_WINDOW", "class": toks[0],
                    "timeout": to_float(toks[1]) if len(toks) > 1 else 10}]
        else:
            raise ValueError("unrecognised insert; see `help`")
        self.snap()
        self.splice(n - 1, rel)
        print(f"Inserted {len(rel)} event(s) before #{n}.")

    def c_copy(self, rest):
        i0, i1 = self.rng(rest.split())
        base = self.ev[i0]["t"]
        self.clip = [dict(e, t=round(e["t"] - base, 4)) for e in copy.deepcopy(self.ev[i0:i1])]
        print(f"Copied {len(self.clip)} event(s).")

    def c_paste(self, rest):
        if not self.clip:
            raise ValueError("clipboard is empty")
        n = to_int(rest.strip(), "N")
        if not 1 <= n <= len(self.ev) + 1:
            raise ValueError(f"N must be within 1..{len(self.ev) + 1}")
        self.snap()
        self.splice(n - 1, self.clip)
        print(f"Pasted {len(self.clip)} event(s) before #{n}.")

    def c_compact(self, rest):
        ms = to_float(rest.strip(), "MS") if rest.strip() else 10.0
        self.snap()
        before = len(self.ev)
        self.ev = compact(self.ev, ms / 1000)
        print(f"{before} -> {len(self.ev)} events.")

    def c_stats(self, rest):
        print("\n".join(stats_lines(self.ev, self.meta)))

    def c_replay(self, rest):
        toks, speed = rest.split(), 1.0
        if "-s" in toks:
            k = toks.index("-s")
            if k + 1 >= len(toks):
                raise ValueError("-s needs a value")
            speed = to_float(toks[k + 1], "SPD")
            if speed <= 0:
                raise ValueError("speed must be > 0")
            del toks[k:k + 2]
        i0, i1 = self.rng(toks) if toks else (0, len(self.ev))
        if len(toks) == 1:
            i1 = len(self.ev)
        quick_play(make_slice(self.ev, i0, i1), speed=speed)

    def c_undo(self, rest):
        if not self.undo_stack:
            raise ValueError("nothing to undo")
        self.redo_stack.append(self.ev)
        self.ev = self.undo_stack.pop()
        self.dirty = True

    def c_redo(self, rest):
        if not self.redo_stack:
            raise ValueError("nothing to redo")
        self.undo_stack.append(self.ev)
        self.ev = self.redo_stack.pop()
        self.dirty = True

    def c_save(self, rest):
        dest = rest.strip() or self.path
        save_macro(dest, self.meta, self.ev)
        if dest == self.path:
            self.dirty = False
        print(f"Saved {len(self.ev)} events to '{dest}'.")

    def repl(self):
        print(f"Editing '{self.path}' - {len(self.ev)} events. Type 'help' for commands.")
        self.c_list("")
        pending_quit = False
        while True:
            try:
                line = input("> ").strip()
            except EOFError:
                print()
                break
            except KeyboardInterrupt:
                print()
                continue
            if not line:
                continue
            cmd, _, rest = line.partition(" ")
            cmd = cmd.lower()
            if cmd in ("q", "quit", "exit"):
                if self.dirty and not pending_quit:
                    print("Unsaved changes. 'save' first, or quit again to discard.")
                    pending_quit = True
                    continue
                break
            pending_quit = False
            handler = getattr(self, "c_" + cmd, None) if cmd.isalnum() else None
            if not handler:
                print(f"Unknown command {cmd!r}. Type 'help'.")
                continue
            try:
                handler(rest.strip())
            except (ValueError, MacroError, Stopped) as e:
                print(f"error: {e}")
            self.resort()


def cmd_edit(a):
    meta, events = load_macro(a.input)
    Editor(a.input, meta, events).repl()


