def _match(want, cls, title):
    w = want.lower()
    return w in (cls or "").lower() or w in (title or "").lower()


class Session:
    name = "unknown"

    def cursor(self):
        return None

    def bounds(self):
        return None

    def list_windows(self):
        raise MacroError("window features need a Hyprland or X11 (xdotool) session")

    def is_focused(self, want):
        raise MacroError("window features need a Hyprland or X11 (xdotool) session")

    def focus(self, want):
        raise MacroError("window features need a Hyprland or X11 (xdotool) session")

    def find(self, want):
        wins = self.list_windows()
        for wid, cls, _t in wins:  # class first, then title
            if want.lower() in cls.lower():
                return wid
        for wid, _c, title in wins:
            if want.lower() in title.lower():
                return wid
        return None

    def wait_focused(self, want, timeout, stop):
        t0 = time.monotonic()
        while not self.is_focused(want):
            if timeout and time.monotonic() - t0 > timeout:
                raise MacroError(f"timed out waiting for window {want!r}")
            if stop.wait(0.15):
                raise Stopped()
        return time.monotonic() - t0


def find_hypr_sock():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    uid = os.environ.get("SUDO_UID") or str(os.getuid())
    bases = [b for b in (os.environ.get("XDG_RUNTIME_DIR"), f"/run/user/{uid}") if b]
    found = []
    for b in dict.fromkeys(bases):
        found += glob.glob(f"{b}/hypr/{sig or '*'}/.socket.sock")
    if not found and sig:
        found += glob.glob(f"/tmp/hypr/{sig}/.socket.sock")
    return max(found, key=os.path.getmtime) if found else None


def hypr_request(sock_path, cmd, timeout=1.0):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(sock_path)
        s.sendall(cmd.encode())
        chunks = []
        while True:
            b = s.recv(65536)
            if not b:
                break
            chunks.append(b)
    finally:
        s.close()
    return b"".join(chunks).decode(errors="replace")


class HyprSession(Session):
    name = "hyprland"

    def __init__(self, sock):
        self.sock = sock

    def _json(self, cmd):
        try:
            return json.loads(hypr_request(self.sock, "j/" + cmd))
        except (OSError, ValueError):
            return None

    def cursor(self):
        d = self._json("cursorpos")
        try:
            return int(round(d["x"])), int(round(d["y"]))
        except (TypeError, KeyError):
            return None

    def bounds(self):
        mons = self._json("monitors")
        if not mons:
            return None
        x0 = y0 = 10 ** 9
        x1 = y1 = -10 ** 9
        for m in mons:
            if m.get("disabled"):
                continue
            w, h = m["width"], m["height"]
            if m.get("transform", 0) % 2 == 1:
                w, h = h, w
            sc = m.get("scale") or 1
            w, h = w / sc, h / sc
            x0, y0 = min(x0, m["x"]), min(y0, m["y"])
            x1, y1 = max(x1, m["x"] + w), max(y1, m["y"] + h)
        return (int(x0), int(y0), int(round(x1 - x0)), int(round(y1 - y0))) if x1 > x0 else None

    def list_windows(self):
        cl = self._json("clients") or []
        return [(c["address"], c.get("class", ""), c.get("title", ""))
                for c in cl if c.get("mapped", True) and not c.get("hidden")]

    def is_focused(self, want):
        d = self._json("activewindow")
        return bool(d and _match(want, d.get("class"), d.get("title")))

    _lua = None  # Hyprland 0.55+ takes Lua expressions in `hyprctl dispatch`

    def focus(self, want):
        addr = self.find(want)
        if not addr:
            raise MacroError(f"no window matching {want!r} (see: macro windows)")
        if not shutil.which("hyprctl"):
            raise MacroError("hyprctl not found")
        if not HyprSession._lua:
            r = _run(["hyprctl", "dispatch", "focuswindow", f"address:{addr}"])
            out = (r.stdout + r.stderr) if r else ""
            if r and r.returncode == 0 and "hl.dispatch" not in out.lower():
                return
        r = _run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'])
        if not r or r.returncode != 0:
            raise MacroError(f"hyprctl failed to focus {addr}: {(r.stdout + r.stderr).strip() if r else ''}")
        HyprSession._lua = True


class X11Session(Session):
    name = "x11"

    def __init__(self):
        self._lib = None
        self._dpy = None
        self._cache = {}

    def _xlib(self):
        if self._lib is None:
            path = ctypes.util.find_library("X11")
            if not path:
                self._lib = False
                return False
            lib = ctypes.CDLL(path)
            lib.XOpenDisplay.restype = ctypes.c_void_p
            lib.XOpenDisplay.argtypes = [ctypes.c_char_p]
            lib.XDefaultRootWindow.restype = ctypes.c_ulong
            lib.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
            lib.XDefaultScreen.argtypes = [ctypes.c_void_p]
            lib.XDisplayWidth.argtypes = [ctypes.c_void_p, ctypes.c_int]
            lib.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]
            lib.XQueryPointer.argtypes = [
                ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong),
                ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int),
                ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int),
                ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_uint)]
            self._dpy = lib.XOpenDisplay(None)
            self._lib = lib if self._dpy else False
        return self._lib

    def cursor(self):
        lib = self._xlib()
        if not lib:
            return None
        rr, cr = ctypes.c_ulong(), ctypes.c_ulong()
        rx, ry, wx, wy = (ctypes.c_int() for _ in range(4))
        mask = ctypes.c_uint()
        ok = lib.XQueryPointer(self._dpy, lib.XDefaultRootWindow(self._dpy), ctypes.byref(rr),
                               ctypes.byref(cr), ctypes.byref(rx), ctypes.byref(ry),
                               ctypes.byref(wx), ctypes.byref(wy), ctypes.byref(mask))
        return (rx.value, ry.value) if ok else None

    def bounds(self):
        lib = self._xlib()
        if not lib:
            return None
        s = lib.XDefaultScreen(self._dpy)
        return (0, 0, lib.XDisplayWidth(self._dpy, s), lib.XDisplayHeight(self._dpy, s))

    def _xdo(self, *args):
        if not shutil.which("xdotool"):
            raise MacroError("xdotool is required for window features under X11")
        r = _run(["xdotool", *args])
        return r.stdout.strip() if r and r.returncode == 0 else ""

    def _info(self, wid):
        if wid not in self._cache:
            self._cache[wid] = (self._xdo("getwindowclassname", wid), self._xdo("getwindowname", wid))
        return self._cache[wid]

    def list_windows(self):
        ids = self._xdo("search", "--onlyvisible", "--name", "").split()
        return [(w, *self._info(w)) for w in ids]

    def is_focused(self, want):
        wid = self._xdo("getactivewindow")
        return bool(wid) and _match(want, *self._info(wid))

    def focus(self, want):
        wid = self.find(want)
        if not wid:
            raise MacroError(f"no X11 window matching {want!r} (see: macro windows)")
        self._xdo("windowactivate", "--sync", wid)


def detect_session():
    sock = find_hypr_sock()
    if sock:
        s = HyprSession(sock)
        if s._json("monitors") is not None:
            return s
    if os.environ.get("DISPLAY"):
        return X11Session()
    return Session()


def resolve_bounds(session, screen_arg):
    return screen_arg or session.bounds()


class FocusGate:
    """Pauses playback whenever the target window is not focused."""

    def __init__(self, session, want, stop):
        self.s, self.want, self.stop = session, want, stop
        self._t, self._ok = 0.0, False

    def ok(self):
        now = time.monotonic()
        if now - self._t > 0.1:  # throttle IPC/subprocess calls
            self._ok, self._t = self.s.is_focused(self.want), now
        return self._ok

    def wait(self):
        if self.ok():
            return 0.0
        t0 = time.monotonic()
        print(f"Paused - focus '{self.want}' to continue.")
        while not self.ok():
            if self.stop.wait(0.15):
                raise Stopped()
        print("Resumed.")
        return time.monotonic() - t0


# ---------------------------------------------------------------------------
# reading input devices (recording + hotkeys)
# ---------------------------------------------------------------------------
class Dev:
    def __init__(self, fd, path, name, kbd, ptr):
        self.fd, self.path, self.name, self.kbd, self.ptr = fd, path, name, kbd, ptr


def _bit(buf, n):
    return n // 8 < len(buf) and bool(buf[n // 8] >> (n % 8) & 1)


def scan_devices(kbd=True, ptr=True):
    devs, denied = [], 0
    for path in sorted(glob.glob("/dev/input/event*")):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except PermissionError:
            denied += 1
            continue
        except OSError:
            continue
        try:
            nb = bytearray(256)
            fcntl.ioctl(fd, EVIOCGNAME, nb)
            name = nb.split(b"\0")[0].decode(errors="replace")

            def caps(ev, size):
                b = bytearray(size)
                fcntl.ioctl(fd, EVIOCGBIT(ev, size), b)
                return b

            types, keys = caps(0, 4), caps(EV_KEY, 96)
            is_kbd = _bit(types, EV_KEY) and _bit(keys, 30) and _bit(keys, 28)
            rel = caps(EV_REL, 2) if _bit(types, EV_REL) else b""
            absb = caps(EV_ABS, 8) if _bit(types, EV_ABS) else b""
            is_ptr = (_bit(rel, REL_X) and _bit(rel, REL_Y) and _bit(keys, 0x110)) or (
                _bit(absb, ABS_X) and _bit(absb, ABS_Y)
                and (_bit(keys, 0x110) or _bit(keys, 0x145) or _bit(keys, 0x14A)))
        except OSError:
            os.close(fd)
            continue
        if name.startswith("macro-py") or not ((kbd and is_kbd) or (ptr and is_ptr)):
            os.close(fd)
            continue
        devs.append(Dev(fd, path, name, is_kbd, is_ptr))
    return devs, denied


def close_devices(devs):
    for d in devs:
        with contextlib.suppress(OSError):
            os.close(d.fd)


def drain(devs):
    for d in devs:
        with contextlib.suppress(OSError):
            while os.read(d.fd, 4096):
                pass


class HotkeyThread(threading.Thread):
    def __init__(self, devs, bindings, callback):
        super().__init__(daemon=True)
        self.devs, self.bindings, self.callback = devs, bindings, callback
        self.halt = threading.Event()

    def run(self):
        fds = {d.fd for d in self.devs}
        pressed = set()
        while not self.halt.is_set() and fds:
            try:
                ready, _, _ = select.select(list(fds), [], [], 0.2)
            except (OSError, ValueError):
                break
            for fd in ready:
                try:
                    data = os.read(fd, EV_SIZE * 64)
                except BlockingIOError:
                    continue
                except OSError:
                    fds.discard(fd)
                    continue
                for off in range(0, len(data) - EV_SIZE + 1, EV_SIZE):
                    _, _, typ, code, val = struct.unpack_from(EV_FMT, data, off)
                    if typ != EV_KEY or code >= 0x100 or val == 2:
                        continue
                    (pressed.add if val else pressed.discard)(code)
                    for name, combo in self.bindings.items():
                        if combo.feed(pressed, code, val):
                            self.callback(name)

    def shutdown(self):
        self.halt.set()
        self.join(1.0)
        close_devices(self.devs)


def start_hotkeys(bindings, callback):
    devs, denied = scan_devices(kbd=True, ptr=False)
    if not devs:
        warn("hotkeys unavailable (" + ("no permission to read /dev/input" if denied else "no keyboards found")
             + "); Ctrl+C still stops")
        return None
    t = HotkeyThread(devs, {n: Combo(s) for n, s in bindings.items()}, callback)
    t.start()
    return t


# ---------------------------------------------------------------------------
# uinput injection
# ---------------------------------------------------------------------------
class UInput:
    def __init__(self, name, keys=(), rels=(), abs_axes=()):
        self.fd = None
        for path in ("/dev/uinput", "/dev/input/uinput"):
            try:
                self.fd = os.open(path, os.O_WRONLY)
                break
            except FileNotFoundError:
                continue
            except PermissionError:
                raise MacroError(f"no permission to open {path}. Run with sudo, or see `macro --help` for a udev rule.")
        if self.fd is None:
            raise MacroError("/dev/uinput not found - try: sudo modprobe uinput")
        fd = self.fd
        if keys:
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
            for k in keys:
                fcntl.ioctl(fd, UI_SET_KEYBIT, k)
        if rels:
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_REL)
            for r in rels:
                fcntl.ioctl(fd, UI_SET_RELBIT, r)
        if abs_axes:
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_ABS)
            for a in abs_axes:
                fcntl.ioctl(fd, UI_SET_ABSBIT, a)
        fcntl.ioctl(fd, UI_DEV_SETUP, struct.pack("=HHHH80sI", 3, 0x1209, 0x0001, 1, name.encode()[:79], 0))
        for a in abs_axes:
            fcntl.ioctl(fd, UI_ABS_SETUP, struct.pack("=H2x6i", a, 0, 0, ABS_RANGE, 0, 0, 0))
        fcntl.ioctl(fd, UI_DEV_CREATE)

    def send(self, events):
        data = b"".join(struct.pack(EV_FMT, 0, 0, t, c, v) for t, c, v in events)
        os.write(self.fd, data + struct.pack(EV_FMT, 0, 0, EV_SYN, 0, 0))

    def close(self):
        if self.fd is not None:
            with contextlib.suppress(OSError):
                fcntl.ioctl(self.fd, UI_DEV_DESTROY)
            with contextlib.suppress(OSError):
                os.close(self.fd)
            self.fd = None


class Injector:
    """Emits macro events. Always releases held keys/buttons on exit (even on Ctrl+C)."""

    def __init__(self, stop, need_abs=False, bounds=None, dry=False, verbose=False, session=None):
        self.stop, self.bounds, self.dry, self.verbose, self.session = stop, bounds, dry, verbose, session
        self.held_keys, self.held_btns = set(), set()
        self.main = self.absd = None
        if need_abs and not bounds:
            raise MacroError("cannot determine screen size for absolute positions; pass --screen WxH[+X+Y]")
        if not dry:
            try:
                self.main = UInput(VIRT, keys=list(range(1, 0x100)) + list(BTN_MAP.values()),
                                   rels=[REL_X, REL_Y, REL_WHEEL, REL_HWHEEL, REL_WHEEL_HI, REL_HWHEEL_HI])
                if need_abs:
                    self.absd = UInput(VIRT + "-abs", keys=[0x110], abs_axes=[ABS_X, ABS_Y])
            except Exception:
                self.close()
                raise
            time.sleep(0.5)  # give the compositor time to pick the devices up

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()
        return False

    def close(self):
        with contextlib.suppress(Exception):
            self.release_all()
        for d in (self.main, self.absd):
            if d:
                d.close()
        self.main = self.absd = None

    def release_all(self):
        if not self.main:
            return
        ev = [(EV_KEY, c, 0) for c in sorted(self.held_keys)] + [(EV_KEY, c, 0) for c in sorted(self.held_btns)]
        if ev:
            self.main.send(ev)
        self.held_keys.clear()
        self.held_btns.clear()

    # -- primitives -------------------------------------------------------
    def _move_abs(self, x, y):
        ox, oy, w, h = self.bounds
        ax = round((min(max(x, ox), ox + w - 1) - ox + 0.5) / w * ABS_RANGE)
        ay = round((min(max(y, oy), oy + h - 1) - oy + 0.5) / h * ABS_RANGE)
        self.absd.send([(EV_ABS, ABS_X, ax), (EV_ABS, ABS_Y, ay)])

    def _type(self, text, delay):
        for ch in text:
            k = char_to_key(ch)
            if not k:
                warn(f"TYPE: cannot type {ch!r} (US layout only); skipped")
                continue
            code, shift = k
            if shift:
                self.main.send([(EV_KEY, 42, 1)])
            self.main.send([(EV_KEY, code, 1)])
            self.main.send([(EV_KEY, code, 0)])
            if shift:
                self.main.send([(EV_KEY, 42, 0)])
            if delay and self.stop.wait(delay):
                raise Stopped()

    def emit(self, e, off=(0, 0)):
        ty = e["type"]
        if self.verbose or self.dry:
            print(fmt_event(e))
        if self.dry:
            return
        if ty == "BUTTON":
            code = BTN_MAP[e["button"]]
            (self.held_btns.add if e["state"] == "press" else self.held_btns.discard)(code)
            self.main.send([(EV_KEY, code, 1 if e["state"] == "press" else 0)])
        elif ty == "KEY":
            (self.held_keys.add if e["state"] == "press" else self.held_keys.discard)(e["code"])
            self.main.send([(EV_KEY, e["code"], 1 if e["state"] == "press" else 0)])
        elif ty == "MOVE":
            ev = [(EV_REL, REL_X, e["dx"])] * bool(e["dx"]) + [(EV_REL, REL_Y, e["dy"])] * bool(e["dy"])
            if ev:
                self.main.send(ev)
        elif ty == "MOVETO":
            self._move_abs(e["x"] + off[0], e["y"] + off[1])
        elif ty == "SCROLL":
            ev = []
            if e.get("dy"):
                ev += [(EV_REL, REL_WHEEL, e["dy"]), (EV_REL, REL_WHEEL_HI, e["dy"] * 120)]
            if e.get("dx"):
                ev += [(EV_REL, REL_HWHEEL, e["dx"]), (EV_REL, REL_HWHEEL_HI, e["dx"] * 120)]
            if ev:
                self.main.send(ev)
        elif ty == "TYPE":
            self._type(e["text"], e.get("delay", 0.02))

    def press_release(self, button, hold):
        self.emit({"t": 0, "type": "BUTTON", "button": button, "state": "press"})
        if hold and self.stop.wait(hold):
            raise Stopped()
        self.emit({"t": 0, "type": "BUTTON", "button": button, "state": "release"})


# ---------------------------------------------------------------------------
# playback engine
# ---------------------------------------------------------------------------
def play_once(events, inj, gate, stop, session, *, speed, jitter, off, limit):
    start = time.monotonic()
    shift = virt = prev_t = 0.0
    for e in events:
        gap = max(0.0, e["t"] - prev_t) / speed
        if jitter:
            gap *= random.uniform(1 - jitter, 1 + jitter)
        prev_t = e["t"]
        virt += gap
        wait_until(start + shift + virt, stop)  # absolute deadlines: no drift
        if limit and time.monotonic() >= limit:
            raise Stopped("max duration reached")
        if gate:
            shift += gate.wait()
        if e["type"] == "WAIT_WINDOW":
            if inj.dry:
                inj.emit(e)
            else:
                print(f"Waiting for window '{e['class']}'...")
                shift += session.wait_focused(e["class"], e.get("timeout", 10), stop)
            continue
        inj.emit(e, off)


def run_macro(events, inj, gate, stop, session, *, speed=1.0, loops=1, gap=0.0, jitter=0.0,
              pos_jitter=0, max_duration=0.0):
    if not events:
        raise MacroError("macro is empty")
    began = time.monotonic()
    limit = began + max_duration if max_duration else 0
    n = 0
    while True:
        off = (random.randint(-pos_jitter, pos_jitter), random.randint(-pos_jitter, pos_jitter)) if pos_jitter else (0, 0)
        play_once(events, inj, gate, stop, session, speed=speed, jitter=jitter, off=off, limit=limit)
        n += 1
        print(f"loop {n} done" + ("" if loops else " (infinite)"))
        if loops and n >= loops:
            return n
        wait_until(time.monotonic() + gap, stop)


def install_signals(stop):
    def handler(signum, _frame):
        stop.set()
        if signum == signal.SIGINT:
            signal.signal(signal.SIGINT, signal.SIG_DFL)  # 2nd Ctrl+C kills hard

    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        with contextlib.suppress(ValueError):
            signal.signal(s, handler)


def player_setup(events, screen, window, stop, verbose=False, dry=False):
    session = detect_session()
    need_abs = any(e["type"] == "MOVETO" for e in events)
    bounds = resolve_bounds(session, screen) if need_abs else None
    gate = None
    if window:
        session.focus(window)
        gate = FocusGate(session, window, stop)
    return session, bounds, need_abs, gate


def quick_play(events, speed=1.0, delay=3, stop_key=DEFAULT_STOP):
    """Used by the editor's `replay`."""
    stop = threading.Event()
    session, bounds, need_abs, _ = player_setup(events, None, None, stop)
    hk = start_hotkeys({"stop": stop_key}, lambda _n: stop.set())
    old = signal.getsignal(signal.SIGINT)
    try:
        install_signals(stop)
        countdown(delay)
        with Injector(stop, need_abs, bounds, session=session) as inj:
            run_macro(events, inj, None, stop, session, speed=speed)
    except Stopped as s:
        print(f"Stopped{': ' + str(s) if str(s) else ''}.")
    finally:
        signal.signal(signal.SIGINT, old)
        if hk:
            hk.shutdown()


# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------
def cmd_click(a):
    stop, active = threading.Event(), threading.Event()
    session = detect_session()
    bounds = resolve_bounds(session, a.screen) if a.at else None
    gate = None
    if a.window:
        session.focus(a.window)
        gate = FocusGate(session, a.window, stop)
    bindings = {"stop": a.stop_key}
    if a.toggle_key:
        bindings["toggle"] = a.toggle_key
    else:
        active.set()

    def on_key(name):
        if name == "stop":
            stop.set()
        elif active.is_set():
            active.clear()
            print("Paused.")
        else:
            active.set()
            print("Running.")

    hk = start_hotkeys(bindings, on_key)
    install_signals(stop)
    base = a.interval / 1000
    n = 0
    try:
        if a.toggle_key:
            print(f"Press {a.toggle_key} to start/pause, {a.stop_key} to quit.")
        elif not a.window:
            countdown(a.delay)
        with Injector(stop, bool(a.at), bounds, session=session) as inj:
            print(f"Clicking ({a.button}, every {a.interval:g}ms). Stop: {a.stop_key} or Ctrl+C.")
            nxt = time.monotonic()
            while True:
                if not active.is_set():
                    if stop.wait(0.1):
                        raise Stopped()
                    nxt = time.monotonic()
                    continue
                if gate:
                    nxt += gate.wait()
                if a.at:
                    off = (random.randint(-a.pos_jitter, a.pos_jitter), random.randint(-a.pos_jitter, a.pos_jitter))
                    inj.emit({"t": 0, "type": "MOVETO", "x": a.at[0], "y": a.at[1]}, off)
                for k in range(2 if a.double else 1):
                    inj.press_release(a.button, a.hold / 1000)
                    if a.double and k == 0 and stop.wait(0.04):
                        raise Stopped()
                n += 1
                if a.count and n >= a.count:
                    break
                nxt += base * (random.uniform(1 - a.jitter, 1 + a.jitter) if a.jitter else 1)
                wait_until(nxt, stop)
    except Stopped:
        pass
    finally:
        if hk:
            hk.shutdown()
    print(f"Done: {n} click(s).")


def cmd_record(a):
    session = detect_session()
    devs, denied = scan_devices(kbd=True, ptr=not a.no_mouse)
    if not devs:
        raise MacroError("cannot read /dev/input/event* (permission denied) - run with sudo or join the 'input' group"
                         if denied else "no input devices found")
    cur = session.cursor()
    mm = a.move
    if mm == "auto":
        mm = "abs" if cur else "rel"
    elif mm == "abs" and not cur:
        close_devices(devs)
        raise MacroError("--move abs needs a cursor source (Hyprland, or X11 with libX11)")
    stop_combo = Combo(a.stop_key)
    start_combo = Combo(a.start_key) if a.start_key else None
    out = a.output or f"macro_{int(time.time())}.{a.format or 'json'}"
    fmt = a.format or guess_format(out)
    sample = a.sample_ms / 1000

    events, pressed, acc = [], set(), [0, 0]
    st = {"rec": start_combo is None, "t0": None, "pend": None, "last": None}
    fds = {d.fd for d in devs}

    def begin(now):
        st["rec"], st["t0"] = True, now
        if mm == "abs" and cur:
            p = session.cursor() or cur
            events.append({"t": 0.0, "type": "MOVETO", "x": p[0], "y": p[1]})
            st["last"] = p

    def flush(now):
        if st["pend"] is None:
            return
        if mm == "rel":
            if acc[0] or acc[1]:
                events.append({"t": round(st["pend"] - st["t0"], 4), "type": "MOVE", "dx": acc[0], "dy": acc[1]})
            acc[0] = acc[1] = 0
        elif mm == "abs":
            p = session.cursor()
            if p and p != st["last"]:
                events.append({"t": round(now - st["t0"], 4), "type": "MOVETO", "x": p[0], "y": p[1]})
                st["last"] = p
        st["pend"] = None

    drain(devs)
    if start_combo:
        print(f"Press {a.start_key} to start recording, {a.stop_key} to stop.")
    else:
        countdown(a.delay)
        drain(devs)
        begin(time.monotonic())
        print(f"Recording ({mm} movement) -> {out}. Press {a.stop_key} or Ctrl+C to stop.")
    finished = False
    try:
        while not finished and fds:
            now = time.monotonic()
            tmo = None
            if st["pend"] is not None:
                tmo = max(0.0, st["pend"] + sample - now)
            if a.timeout and st["t0"]:
                left = max(0.0, st["t0"] + a.timeout - now)
                tmo = left if tmo is None else min(tmo, left)
            ready, _, _ = select.select(list(fds), [], [], tmo)
            now = time.monotonic()
            for fd in ready:
                try:
                    data = os.read(fd, EV_SIZE * 128)
                except BlockingIOError:
                    continue
                except OSError:
                    fds.discard(fd)
                    continue
                for off in range(0, len(data) - EV_SIZE + 1, EV_SIZE):
                    _, _, typ, code, val = struct.unpack_from(EV_FMT, data, off)
                    if typ == EV_KEY and code < 0x100:
                        if val == 2:
                            continue
                        (pressed.add if val else pressed.discard)(code)
                        if not st["rec"]:
                            if start_combo.feed(pressed, code, val):
                                begin(now)
                                print("Recording...")
                            continue
                        if stop_combo.feed(pressed, code, val):
                            finished = True
                            break
                        if not a.no_keys:
                            flush(now)
                            events.append({"t": round(now - st["t0"], 4), "type": "KEY", "code": code,
                                           "state": "press" if val else "release"})
                    elif not st["rec"] or a.no_mouse:
                        continue
                    elif typ == EV_KEY and code in BTN_NAME and val != 2:
                        if st["pend"] is not None and mm == "abs":
                            time.sleep(0.002)
                        flush(now)
                        events.append({"t": round(now - st["t0"], 4), "type": "BUTTON", "button": BTN_NAME[code],
                                       "state": "press" if val else "release"})
                    elif typ == EV_REL and code in (REL_X, REL_Y):
                        if mm == "none":
                            continue
                        if st["pend"] is None:
                            st["pend"] = now
                        if mm == "rel":
                            acc[code] += val
                    elif typ == EV_REL and code in (REL_WHEEL, REL_HWHEEL):
                        flush(now)
                        ev = {"t": round(now - st["t0"], 4), "type": "SCROLL", "dx": 0, "dy": 0}
                        ev["dy" if code == REL_WHEEL else "dx"] = val
                        events.append(ev)
                    elif typ == EV_ABS and mm == "abs" and st["pend"] is None:
                        st["pend"] = now
                if finished:
                    break
            if st["pend"] is not None and time.monotonic() - st["pend"] >= sample:
                flush(time.monotonic())
            if a.timeout and st["t0"] and time.monotonic() - st["t0"] >= a.timeout:
                finished = True
    except KeyboardInterrupt:
        print()
    finally:
        close_devices(devs)
    if not st["rec"]:
        raise MacroError("recording never started")
    flush(time.monotonic())
    while events and events[-1]["type"] == "KEY" and events[-1]["code"] in stop_combo.codes:
        events.pop()  # don't record the stop hotkey itself
    events = balance(events)
    bounds = session.bounds() if mm == "abs" else None
    meta = {"type": "META", "v": FORMAT_VERSION, "created": datetime.now().isoformat(timespec="seconds"),
            "session": session.name, "screen": list(bounds) if bounds else None, "move": mm}
    save_macro(out, meta, events, fmt)
    dur = events[-1]["t"] if events else 0
    print(f"Recorded {len(events)} events ({dur:.1f}s) to '{out}'.")


def cmd_play(a):
    meta, events = load_macro(a.input)
    if a.from_event or a.to_event:
        i0 = (a.from_event or 1) - 1
        i1 = a.to_event or len(events)
        if not (0 <= i0 < i1 <= len(events)):
            raise MacroError(f"event range must be within 1..{len(events)}")
        events = make_slice(events, i0, i1)
    if a.dry_run:
        print(f"# dry run: {len(events)} events at {a.speed}x, {a.loops or 'infinite'} loop(s)")
        for e in events:
            e2 = dict(e, t=round(e["t"] / a.speed, 4))
            print(fmt_event(e2))
        return
    stop = threading.Event()
    session, bounds, need_abs, gate = player_setup(events, a.screen, a.window, stop)
    if need_abs and meta.get("screen") and bounds and list(bounds) != list(meta["screen"]):
        warn(f"macro was recorded at screen {meta['screen']} but current screen is {list(bounds)}; "
             "positions may be off")
    hk = start_hotkeys({"stop": a.stop_key}, lambda _n: stop.set())
    install_signals(stop)
    try:
        if not a.window:
            countdown(a.delay)
        print(f"Playing '{a.input}' ({len(events)} events, {a.speed}x). Stop: {a.stop_key} or Ctrl+C.")
        with Injector(stop, need_abs, bounds, verbose=a.verbose, session=session) as inj:
            run_macro(events, inj, gate, stop, session, speed=a.speed, loops=a.loops, gap=a.gap,
                      jitter=a.jitter, pos_jitter=a.pos_jitter, max_duration=a.max_duration)
        print("Playback finished.")
    except Stopped as s:
        print(f"Stopped{': ' + str(s) if str(s) else ''}.")
    finally:
        if hk:
            hk.shutdown()


def cmd_convert(a):
    meta, events = load_macro(a.input)
    fmt = a.to or guess_format(a.output)
    save_macro(a.output, meta, events, fmt)
    print(f"Converted '{a.input}' -> '{a.output}' ({fmt}, {len(events)} events).")


def cmd_trim(a):
    meta, events = load_macro(a.input)
    end = a.end if a.end is not None else float("inf")
    if end < a.start:
        raise MacroError("end must be >= start")
    idx = [i for i, e in enumerate(events) if a.start <= e["t"] <= end]
    if not idx:
        raise MacroError("no events in that time range")
    out = make_slice(events, idx[0], idx[-1] + 1, base=a.start)
    save_macro(a.output, meta, out)
    print(f"Trimmed to [{a.start}, {a.end if a.end is not None else 'end'}] -> '{a.output}' ({len(out)} events).")


def cmd_merge(a):
    meta_all, merged, offset = {}, [], 0.0
    for n, path in enumerate(a.inputs):
        meta, events = load_macro(path)
        if n == 0:
            meta_all = meta
        if merged:
            offset = merged[-1]["t"] + a.gap
        merged += [dict(e, t=round(e["t"] + offset, 4)) for e in events]
    save_macro(a.output, meta_all, merged)
    print(f"Merged {len(a.inputs)} macros -> '{a.output}' ({len(merged)} events, {merged[-1]['t']:.2f}s).")


def cmd_compact(a):
    meta, events = load_macro(a.input)
    out = compact(events, a.window_ms / 1000)
    save_macro(a.output or a.input, meta, out)
    print(f"Compacted {len(events)} -> {len(out)} events.")


def cmd_stats(a):
    meta, events = load_macro(a.input)
    print("\n".join(stats_lines(events, meta)))


def cmd_windows(_a):
    s = detect_session()
    print(f"session: {s.name}")
    for wid, cls, title in s.list_windows():
        print(f"{wid:<14} {cls:<28} {title[:60]}")


def cmd_keys(_a):
    seen = set()
    for name, code in sorted(KEYNAMES.items(), key=lambda kv: (kv[1], kv[0])):
        if code not in seen:
            seen.add(code)
            alts = [n for n, c in KEYNAMES.items() if c == code and n != name]
            print(f"{code:>4}  {name}" + (f"   (also: {', '.join(alts)})" if alts else ""))
    print("Mouse buttons: " + ", ".join(BTN_MAP))


