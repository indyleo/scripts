def _run(cmd, timeout=3):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def wait_until(deadline, stop):
    rem = deadline - time.monotonic()
    if rem > 0:
        if stop.wait(rem):
            raise Stopped()
    elif stop.is_set():
        raise Stopped()


def countdown(secs):
    n = int(secs)
    if n <= 0:
        return
    for i in range(n, 0, -1):
        print(f"\rStarting in {i}... ", end="", flush=True)
        time.sleep(1)
    print("\rGo!               ")


def fix_owner(path):
    """When run through sudo, hand files back to the invoking user."""
    if os.geteuid() == 0 and os.environ.get("SUDO_UID"):
        with contextlib.suppress(OSError, ValueError):
            os.chown(path, int(os.environ["SUDO_UID"]), int(os.environ.get("SUDO_GID", "-1")))


def invoking_home():
    user = os.environ.get("SUDO_USER")
    if user:
        with contextlib.suppress(KeyError):
            return Path(pwd.getpwnam(user).pw_dir)
    return Path.home()


def to_int(s, what="number"):
    if not re.fullmatch(r"\d+", s or ""):
        raise ValueError(f"{what} must be a non-negative integer, got {s!r}")
    return int(s)


def to_float(s, what="number"):
    if not re.fullmatch(r"[-+]?(\d+(\.\d*)?|\.\d+)", s or ""):
        raise ValueError(f"{what} must be a number, got {s!r}")
    return float(s)


# argparse "type" helpers
def _pos_float(s):
    try:
        v = float(s)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number: {s!r}")
    if v <= 0:
        raise argparse.ArgumentTypeError("must be > 0")
    return v


def _nonneg_float(s):
    try:
        v = float(s)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number: {s!r}")
    if v < 0:
        raise argparse.ArgumentTypeError("must be >= 0")
    return v


def _nonneg_int(s):
    if not re.fullmatch(r"\d+", s):
        raise argparse.ArgumentTypeError("must be a non-negative integer")
    return int(s)


def _jitter(s):
    try:
        v = float(s[:-1]) / 100 if s.endswith("%") else float(s)
    except ValueError:
        raise argparse.ArgumentTypeError("use e.g. 10% or 0.1")
    if not 0 <= v < 1:
        raise argparse.ArgumentTypeError("jitter must be in [0%, 100%)")
    return v


def _xy(s):
    m = re.fullmatch(r"\s*(-?\d+)\s*,\s*(-?\d+)\s*", s)
    if not m:
        raise argparse.ArgumentTypeError("use X,Y")
    return int(m[1]), int(m[2])


def _screen(s):
    m = re.fullmatch(r"(\d+)x(\d+)(?:\+(-?\d+)\+(-?\d+))?", s)
    if not m:
        raise argparse.ArgumentTypeError("use WxH or WxH+X+Y")
    return int(m[3] or 0), int(m[4] or 0), int(m[1]), int(m[2])


def _combo(s):
    try:
        Combo(s)
    except MacroError as e:
        raise argparse.ArgumentTypeError(str(e))
    return s


# ---------------------------------------------------------------------------
# macro file model
#   NDJSON, one event per line, first line optional META:
#     {"type":"META","v":2,"session":"hyprland","screen":[0,0,1920,1080],...}
#     {"t":0.1,"type":"BUTTON","button":"left","state":"press"}
#     {"t":0.2,"type":"MOVE","dx":5,"dy":-2}           relative
#     {"t":0.2,"type":"MOVETO","x":640,"y":360}        absolute (screen px)
#     {"t":0.3,"type":"SCROLL","dx":0,"dy":-1}
#     {"t":0.4,"type":"KEY","code":30,"state":"press"}
#     {"t":0.5,"type":"TYPE","text":"hello","delay":0.02}
#     {"t":0.6,"type":"WAIT_WINDOW","class":"firefox","timeout":10}
#   Legacy tab-separated .mac files (BUTTON/MOVE/KEY only) are still read/written.
# ---------------------------------------------------------------------------
EVENT_TYPES = ("BUTTON", "MOVE", "MOVETO", "SCROLL", "KEY", "TYPE", "WAIT_WINDOW")
MAC_TYPES = ("BUTTON", "MOVE", "KEY")


def validate_event(e):
    """Coerce fields in place; return an error string or None."""
    try:
        if not isinstance(e, dict) or e.get("type") not in EVENT_TYPES:
            return "unknown event type"
        e["t"] = round(float(e["t"]), 4)
        if e["t"] < 0:
            return "negative timestamp"
        ty = e["type"]
        if ty == "BUTTON":
            if e["button"] not in BTN_MAP or e["state"] not in ("press", "release"):
                return "bad button/state"
        elif ty == "KEY":
            e["code"] = int(e["code"])
            if e["state"] not in ("press", "release"):
                return "bad state"
        elif ty == "MOVE":
            e["dx"], e["dy"] = int(round(float(e["dx"]))), int(round(float(e["dy"])))
        elif ty == "MOVETO":
            e["x"], e["y"] = int(round(float(e["x"]))), int(round(float(e["y"])))
        elif ty == "SCROLL":
            e["dx"], e["dy"] = int(e.get("dx", 0)), int(e.get("dy", 0))
        elif ty == "TYPE":
            e["text"] = str(e["text"])
        elif ty == "WAIT_WINDOW":
            e["class"] = str(e["class"])
    except (KeyError, TypeError, ValueError) as ex:
        return f"missing/invalid field ({ex})"
    return None


def guess_format(path, lines=()):
    suf = Path(path).suffix.lower()
    if suf in (".json", ".ndjson", ".jsonl"):
        return "json"
    if suf == ".mac":
        return "mac"
    first = next((ln for ln in lines if ln.strip()), "")
    return "mac" if first and not first.lstrip().startswith("{") else "json"


def _parse_tsv(line):
    f = line.rstrip("\n").split("\t")
    t, ty = float(f[0]), f[1]
    if ty == "BUTTON":
        return {"t": t, "type": ty, "button": f[2], "state": f[3]}
    if ty == "MOVE":
        return {"t": t, "type": ty, "dx": float(f[2]), "dy": float(f[3])}
    if ty == "KEY":
        return {"t": t, "type": ty, "code": int(f[2]), "state": f[3]}
    raise ValueError("unknown type")


def load_macro(path):
    p = Path(path)
    if not p.is_file():
        raise MacroError(f"no such file: {path}")
    lines = p.read_text().splitlines()
    fmt = guess_format(p, lines)
    meta, events, bad = {}, [], 0
    for n, line in enumerate(lines, 1):
        if not line.strip():
            continue
        try:
            e = json.loads(line) if fmt == "json" else _parse_tsv(line)
        except (ValueError, IndexError):
            warn(f"{path}:{n}: unparseable line skipped")
            bad += 1
            continue
        if isinstance(e, dict) and e.get("type") == "META":
            meta = e
            continue
        err = validate_event(e)
        if err:
            warn(f"{path}:{n}: {err}; skipped")
            bad += 1
            continue
        events.append(e)
    events.sort(key=lambda e: e["t"])  # stable
    return meta, events


def save_macro(path, meta, events, fmt=None):
    fmt = fmt or guess_format(path)
    out = []
    if fmt == "json":
        if meta:
            out.append(json.dumps(meta, separators=(",", ":")))
        out += [json.dumps(e, separators=(",", ":")) for e in events]
    else:
        dropped = 0
        for e in events:
            ty = e["type"]
            if ty == "BUTTON":
                out.append(f'{e["t"]}\tBUTTON\t{e["button"]}\t{e["state"]}')
            elif ty == "MOVE":
                out.append(f'{e["t"]}\tMOVE\t{e["dx"]}\t{e["dy"]}')
            elif ty == "KEY":
                out.append(f'{e["t"]}\tKEY\t{e["code"]}\t{e["state"]}')
            else:
                dropped += 1
        if dropped:
            warn(f"{dropped} event(s) not representable in .mac format were dropped")
    tmp = f"{path}.tmp{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)  # may contain typed passwords
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(out) + ("\n" if out else ""))
    os.replace(tmp, path)
    fix_owner(path)


def balance(events):
    """Drop releases of never-pressed inputs; release anything still held at the end."""
    held_k, held_b, out = set(), set(), []
    for e in events:
        if e["type"] == "KEY":
            if e["state"] == "press":
                held_k.add(e["code"])
            elif e["code"] in held_k:
                held_k.discard(e["code"])
            else:
                continue
        elif e["type"] == "BUTTON":
            if e["state"] == "press":
                held_b.add(e["button"])
            elif e["button"] in held_b:
                held_b.discard(e["button"])
            else:
                continue
        out.append(e)
    end = out[-1]["t"] if out else 0.0
    out += [{"t": end, "type": "KEY", "code": c, "state": "release"} for c in sorted(held_k)]
    out += [{"t": end, "type": "BUTTON", "button": b, "state": "release"} for b in sorted(held_b)]
    return out


def make_slice(events, i0, i1, base=None):
    """events[i0:i1] rebased to t=0, keeping the cursor position and input balance."""
    chunk = copy.deepcopy(events[i0:i1])
    if not chunk:
        return []
    base = chunk[0]["t"] if base is None else base
    for e in chunk:
        e["t"] = round(max(0.0, e["t"] - base), 4)
    pos = next((e for e in reversed(events[:i0]) if e["type"] == "MOVETO"), None)
    if pos and not (chunk[0]["type"] == "MOVETO" and chunk[0]["t"] == 0):
        chunk.insert(0, {"t": 0.0, "type": "MOVETO", "x": pos["x"], "y": pos["y"]})
    return balance(chunk)


def compact(events, window=0.01):
    """Merge bursts of MOVE/SCROLL, drop zero moves and repeated MOVETOs."""
    out, last_abs = [], None
    for e in copy.deepcopy(events):
        ty, prev = e["type"], (out[-1] if out else None)
        if ty == "MOVE":
            last_abs = None
            if e["dx"] == 0 and e["dy"] == 0:
                continue
            if prev and prev["type"] == "MOVE" and e["t"] - prev["t"] <= window:
                prev["dx"] += e["dx"]
                prev["dy"] += e["dy"]
                continue
        elif ty == "MOVETO":
            if (e["x"], e["y"]) == last_abs:
                continue
            last_abs = (e["x"], e["y"])
            if prev and prev["type"] == "MOVETO" and e["t"] - prev["t"] <= window:
                prev["x"], prev["y"] = e["x"], e["y"]
                continue
        elif ty == "SCROLL":
            if prev and prev["type"] == "SCROLL" and e["t"] - prev["t"] <= window:
                prev["dx"] += e["dx"]
                prev["dy"] += e["dy"]
                continue
        out.append(e)
    return out


def fmt_event(e):
    ty = e["type"]
    if ty == "BUTTON":
        d = f'{e["button"]} {e["state"]}'
    elif ty == "MOVE":
        d = f'dx={e["dx"]} dy={e["dy"]}'
    elif ty == "MOVETO":
        d = f'x={e["x"]} y={e["y"]}'
    elif ty == "SCROLL":
        d = f'dx={e["dx"]} dy={e["dy"]}'
    elif ty == "KEY":
        d = f'{key_name(e["code"])} ({e["code"]}) {e["state"]}'
    elif ty == "TYPE":
        d = repr(e["text"])
    else:
        d = f'{e["class"]} timeout={e.get("timeout", 10)}'
    return f'{e["t"]:9.3f}  {ty:<11} {d}'


def stats_lines(events, meta=None):
    if not events:
        return ["empty macro"]
    c = Counter(e["type"] for e in events)
    lines = [f"events   : {len(events)}", f"duration : {events[-1]['t']:.3f}s"]
    lines.append("types    : " + ", ".join(f"{k}={v}" for k, v in sorted(c.items())))
    xs = [e["x"] for e in events if e["type"] == "MOVETO"]
    ys = [e["y"] for e in events if e["type"] == "MOVETO"]
    if xs:
        lines.append(f"abs area : x {min(xs)}..{max(xs)}, y {min(ys)}..{max(ys)}")
    rel = [(e["dx"], e["dy"]) for e in events if e["type"] == "MOVE"]
    if rel:
        lines.append(f"rel move : net ({sum(a for a, _ in rel)}, {sum(b for _, b in rel)})")
    keys = Counter(key_name(e["code"]) for e in events if e["type"] == "KEY" and e["state"] == "press")
    if keys:
        lines.append("keys     : " + ", ".join(f"{k}x{v}" for k, v in keys.most_common(8)))
    if meta:
        lines.append(f"meta     : session={meta.get('session')} screen={meta.get('screen')} move={meta.get('move')}")
    return lines


