def parse_key(s):
    s = str(s).strip().lower()
    if s.startswith("key_"):
        s = s[4:]
    if s.isdigit():
        return int(s)
    if s in KEYNAMES:
        return KEYNAMES[s]
    raise MacroError(f"unknown key {s!r} (see: macro keys)")


def key_name(code):
    return CODE2NAME.get(code, str(code))


def char_to_key(ch):
    """-> (keycode, needs_shift) for a US-layout character, or None."""
    if ch in CHAR2CODE:
        return CHAR2CODE[ch], False
    if ch.isalpha() and ch.lower() in CHAR2CODE and ch.isascii():
        return CHAR2CODE[ch.lower()], ch.isupper()
    if ch in SHIFTED:
        return CHAR2CODE[SHIFTED[ch]], True
    return None


class Combo:
    """A hotkey like 'ctrl+alt+q'. Left/right modifier variants both count."""

    def __init__(self, spec):
        self.spec = spec
        self.groups = []
        for part in spec.lower().split("+"):
            part = part.strip()
            self.groups.append(set(MOD_ALTS[part]) if part in MOD_ALTS else {parse_key(part)})
        self.codes = set().union(*self.groups)

    def feed(self, pressed, code, value):
        """`pressed` is the caller's live set of held keycodes (already updated)."""
        return (value == 1 and any(code in g for g in self.groups)
                and all(g & pressed for g in self.groups))


