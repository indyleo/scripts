EPILOG = f"""\
Setup (one-time, so you don't need sudo):
  sudo modprobe uinput
  echo 'KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"' \\
      | sudo tee /etc/udev/rules.d/99-macro.rules
  sudo usermod -aG input $USER      # log out/in afterwards
Note: membership in 'input' lets a program read all keystrokes; treat it accordingly.

Stop hotkey defaults to {DEFAULT_STOP} (works even while another window has focus).
Defaults can be set in ~/.config/macro/config.toml, e.g.:
  [defaults]
  stop_key = "ctrl+alt+x"
  [record]
  delay = 5
"""


def build_parser():
    p = argparse.ArgumentParser(prog="macro", description=__doc__.split("\n\n")[0],
                                epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")
    subs = {}

    def add(name, func, help_):
        sp = sub.add_parser(name, help=help_, description=help_,
                            formatter_class=argparse.ArgumentDefaultsHelpFormatter)
        sp.set_defaults(func=func)
        subs[name] = sp
        return sp

    def common_run(sp, delay_default=3):
        sp.add_argument("-d", "--delay", type=_nonneg_int, default=delay_default,
                        help="countdown seconds before starting (ignored with -w)")
        sp.add_argument("--stop-key", type=_combo, default=DEFAULT_STOP, help="global stop hotkey")
        sp.add_argument("--screen", type=_screen, help="override screen bounds, WxH or WxH+X+Y")

    sp = add("click", cmd_click, "repeated clicking")
    sp.add_argument("-r", "--interval", type=_pos_float, default=100, help="ms between clicks")
    sp.add_argument("-b", "--button", choices=list(BTN_MAP), default="left")
    sp.add_argument("-c", "--count", type=_nonneg_int, default=0, help="number of clicks (0 = infinite)")
    sp.add_argument("--hold", type=_nonneg_float, default=10, help="ms the button is held down")
    sp.add_argument("--double", action="store_true", help="double-click each time")
    sp.add_argument("--at", type=_xy, help="move to X,Y (screen pixels) before each click")
    sp.add_argument("--jitter", type=_jitter, default=0.0, help="randomise interval, e.g. 20%%")
    sp.add_argument("--pos-jitter", type=_nonneg_int, default=0, help="randomise --at by +-PX")
    sp.add_argument("-w", "--window", help="only click while this window class/title is focused")
    sp.add_argument("--toggle-key", type=_combo, help="hotkey that starts/pauses clicking (starts paused)")
    common_run(sp)

    sp = add("record", cmd_record, "record mouse + keyboard (needs read access to /dev/input)")
    sp.add_argument("-o", "--output", help="output file (default macro_<time>.json)")
    sp.add_argument("-t", "--timeout", type=_nonneg_float, default=0, help="stop after SECS (0 = manual)")
    sp.add_argument("-f", "--format", choices=["json", "mac"], help="file format (default: from extension)")
    sp.add_argument("--start-key", type=_combo, help="wait for this hotkey before recording")
    sp.add_argument("--move", choices=["auto", "abs", "rel", "none"], default="auto",
                    help="abs = cursor positions (best fidelity), rel = raw device deltas")
    sp.add_argument("--sample-ms", type=_pos_float, default=8, help="motion sampling/coalescing interval")
    sp.add_argument("--no-keys", action="store_true", help="don't record keyboard events (privacy)")
    sp.add_argument("--no-mouse", action="store_true", help="don't record mouse events")
    common_run(sp, delay_default=3)

    sp = add("play", cmd_play, "replay a macro")
    sp.add_argument("-i", "--input", required=True)
    sp.add_argument("-l", "--loops", type=_nonneg_int, default=1, help="0 = infinite")
    sp.add_argument("-s", "--speed", type=_pos_float, default=1.0)
    sp.add_argument("-g", "--gap", type=_nonneg_float, default=0.0, help="seconds between loops")
    sp.add_argument("-w", "--window", help="only play while this window class/title is focused (pauses otherwise)")
    sp.add_argument("--jitter", type=_jitter, default=0.0, help="randomise timing, e.g. 10%%")
    sp.add_argument("--pos-jitter", type=_nonneg_int, default=0, help="shift absolute positions by up to +-PX per loop")
    sp.add_argument("--max-duration", type=_nonneg_float, default=0.0, help="hard stop after SECS")
    sp.add_argument("--from-event", type=_nonneg_int, help="start at event N (1-based)")
    sp.add_argument("--to-event", type=_nonneg_int, help="end at event N")
    sp.add_argument("--dry-run", action="store_true", help="print the schedule; inject nothing")
    sp.add_argument("--verbose", action="store_true", help="print each event as it is sent")
    common_run(sp)

    sp = add("edit", cmd_edit, "interactive editor (undo, insert, copy/paste, compact, replay...)")
    sp.add_argument("-i", "--input", required=True)

    sp = add("convert", cmd_convert, "convert between .json and legacy .mac")
    sp.add_argument("-i", "--input", required=True)
    sp.add_argument("-o", "--output", required=True)
    sp.add_argument("--to", choices=["json", "mac"])

    sp = add("trim", cmd_trim, "keep only events in a time range")
    sp.add_argument("-i", "--input", required=True)
    sp.add_argument("-o", "--output", required=True)
    sp.add_argument("-s", "--start", type=_nonneg_float, default=0.0)
    sp.add_argument("-e", "--end", type=_nonneg_float)

    sp = add("merge", cmd_merge, "concatenate macros")
    sp.add_argument("inputs", nargs="+")
    sp.add_argument("-o", "--output", required=True)
    sp.add_argument("--gap", type=_nonneg_float, default=0.5, help="seconds between macros")

    sp = add("compact", cmd_compact, "merge motion bursts and drop no-op events")
    sp.add_argument("-i", "--input", required=True)
    sp.add_argument("-o", "--output", help="default: overwrite input")
    sp.add_argument("--window-ms", type=_pos_float, default=10)

    sp = add("stats", cmd_stats, "summarise a macro")
    sp.add_argument("-i", "--input", required=True)

    add("windows", cmd_windows, "list windows (for -w)")
    add("keys", cmd_keys, "list key names accepted by hotkeys and the editor")

    apply_config(subs)
    return p


def apply_config(subs):
    if not tomllib:
        return
    path = Path(os.environ.get("XDG_CONFIG_HOME") or invoking_home() / ".config") / "macro" / "config.toml"
    try:
        cfg = tomllib.loads(path.read_text())
    except FileNotFoundError:
        return
    except (OSError, ValueError) as e:
        warn(f"ignoring {path}: {e}")
        return
    for name, sp in subs.items():
        known = {act.dest for act in sp._actions}
        merged = {**cfg.get("defaults", {}), **cfg.get(name, {})}
        sp.set_defaults(**{k: v for k, v in merged.items() if k in known})


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.func(args) or 0
    except MacroError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    except Stopped as s:
        print(f"Stopped{': ' + str(s) if str(s) else ''}.")
        return 0
    except KeyboardInterrupt:
        print()
        return 130


if __name__ == "__main__":
    with contextlib.suppress(AttributeError, ValueError):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # quiet `| head`
    sys.exit(main())
