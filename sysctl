#!/usr/bin/env bash
set -euo pipefail

# Constants
SCRIPT_NAME=$(basename "$0")

# Check required commands
DEPS=(brightnessctl wpctl nmcli bluetoothctl awk notify-send)
for cmd in "${DEPS[@]}"; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: Required command '$cmd' is not installed." >&2
        exit 1
    fi
done

# Arguments
subsys="${1:-}"
action="${2:-}"
amount="${3:-5}" # Default step/set amount is 5%

# Validate numeric argument (amount)
if [[ "$amount" =~ ^-?[0-9]+$ ]]; then
    # Ensure positive number
    amount=${amount#-}
else
    echo "Error: Amount must be an integer. Got '$amount'." >&2
    exit 1
fi

# --- Helper Functions ---

# Run command and report
function run_cmd() {
    if "$@"; then
        echo " Success: $*"
    else
        echo "󰜺 Failed: $*" >&2
        exit 1
    fi
}

# --- Audio (wpctl) Logic ---

function adjust_volume() {
    local target="$1" # @DEFAULT_AUDIO_SINK@ or @DEFAULT_AUDIO_SOURCE@
    local mode="$2"   # "inc", "dec", or "set"
    local limit="$3"  # Max volume (1.0 for sink, maybe higher for mic)

    # Convert percentage (5) to decimal (0.05)
    local step
    step=$(awk "BEGIN {print $amount/100}")

    # Construct the command
    if [[ "$mode" == "inc" ]]; then
        if [[ "$limit" == "1.0" ]]; then
            run_cmd wpctl set-volume "$target" "${step}+" --limit 1.0
        else
            run_cmd wpctl set-volume "$target" "${step}+"
        fi
    elif [[ "$mode" == "dec" ]]; then
        run_cmd wpctl set-volume "$target" "${step}-"
    elif [[ "$mode" == "set" ]]; then
        run_cmd wpctl set-volume "$target" "${step}"
    fi
}

function toggle_mute() {
    local target="$1"
    run_cmd wpctl set-mute "$target" toggle
}

# --- Brightness Logic ---

function adjust_brightness() {
    local mode="$1" # "+", "-", or "set"
    if [[ "$mode" == "set" ]]; then
        run_cmd brightnessctl set "${amount}%"
    else
        run_cmd brightnessctl set "${amount}%${mode}"
    fi
}

function toggle_brightness() {
    local current_max current_val percent
    current_val=$(brightnessctl get)
    current_max=$(brightnessctl max)
    percent=$(( current_val * 100 / current_max ))

    if [[ $percent -gt 50 ]]; then
        run_cmd brightnessctl set "10%"
    else
        run_cmd brightnessctl set "100%"
    fi
}

# --- Keyboard Backlight Logic ---

function _read_file() {
    # Zero-fork read of a single-line file (avoids spawning `cat` just to
    # read one value) -- matters here specifically because sysctl runs
    # synchronously under osd.c's blocking runargv_wait(), so every fork
    # avoided directly shortens how long the WM is frozen per keypress.
    # Usage: _read_file VARNAME FILE [DEFAULT]
    local -n _out="$1"
    { read -r _out < "$2"; } 2>/dev/null || _out="${3:-}"
}

function find_kbd_device() {
    local d name
    for d in /sys/class/leds/*; do
        [[ -d "$d" ]] || continue
        name=$(basename "$d")
        if [[ "$name" == *kbd* || "$name" == *keyboard* ]]; then
            if [[ -f "$d/brightness" && -f "$d/max_brightness" ]]; then
                echo "$d"
                return 0
            fi
        fi
    done

    # Fallback to common names
    for name in "kbd_backlight" "platform::kbd_backlight" "tpacpi::kbd_backlight" "dell::kbd_backlight"; do
        if [[ -d "/sys/class/leds/$name" && -f "/sys/class/leds/$name/brightness" ]]; then
            echo "/sys/class/leds/$name"
            return 0
        fi
    done
    return 1
}

function write_kbd_brightness() {
    # run_cmd execs "$@" directly (no shell), so it can't express a `>`
    # redirect -- that's what the `bash -c "echo ... > file"` calls below
    # used to be for. But sysctl runs synchronously under osd.c's
    # blocking runargv_wait() (the whole WM freezes until this returns),
    # and scroll-wheel adjustments can fire many of these a second, so
    # spawning a full extra bash process just to perform one write is
    # avoidable latency on every one of them. A plain redirect in the
    # current shell does the same write with zero forks.
    local dir="$1" value="$2"
    if echo "$value" > "$dir/brightness" 2>/dev/null; then
        echo " Success: keyboard backlight -> ${value}"
    else
        echo "󰜺 Failed: could not write $dir/brightness" >&2
        exit 1
    fi
}

function adjust_kbd_brightness() {
    local mode="$1" # "+", "-", or "set"
    local dir cur_br max_br new_br step_raw

    dir=$(find_kbd_device) || { echo "Error: No keyboard backlight found" >&2; exit 1; }
    _read_file max_br "$dir/max_brightness" 0
    _read_file cur_br "$dir/brightness" 0

    [[ "$max_br" -eq 0 ]] && { echo "Error: max_brightness is 0" >&2; exit 1; }

    if [[ "$mode" == "set" ]]; then
        new_br=$(( (amount * max_br + 50) / 100 ))
    else
        # Calculate how many raw steps the requested percentage represents
        step_raw=$(( (amount * max_br + 50) / 100 ))

        # FIX: Force at least 1 step to ensure low-resolution backlights (like max=2) actually change
        [[ $step_raw -eq 0 ]] && step_raw=1

        if [[ "$mode" == "+" ]]; then
            new_br=$(( cur_br + step_raw ))
        elif [[ "$mode" == "-" ]]; then
            new_br=$(( cur_br - step_raw ))
        fi
    fi

    # Enforce boundaries
    [[ $new_br -gt $max_br ]] && new_br=$max_br
    [[ $new_br -lt 0 ]] && new_br=0

    write_kbd_brightness "$dir" "$new_br"
}

function toggle_kbd_brightness() {
    local dir cur_br max_br
    dir=$(find_kbd_device) || { echo "Error: No keyboard backlight found" >&2; exit 1; }
    _read_file cur_br "$dir/brightness" 0
    _read_file max_br "$dir/max_brightness" 0

    [[ "$max_br" -eq 0 ]] && exit 1

    if [[ "$cur_br" -eq 0 ]]; then
        write_kbd_brightness "$dir" "$max_br"
    else
        write_kbd_brightness "$dir" "0"
    fi
}

# --- Network/Radio Logic ---

function wifi_toggle() {
    local state
    state=$(nmcli radio wifi)
    if [[ "$state" == "enabled" ]]; then
        run_cmd nmcli radio wifi off
    else
        run_cmd nmcli radio wifi on
    fi
}

function bt_toggle() {
    local state
    state=$(bluetoothctl show | grep "Powered: yes" || true)
    if [[ -n "$state" ]]; then
        run_cmd bluetoothctl power off
    else
        run_cmd bluetoothctl power on
    fi
}

function airplane_toggle() {
    local wifi_state bt_state
    wifi_state=$(nmcli radio wifi)
    bt_state=$(bluetoothctl show | grep -c "Powered: yes" || true)

    if [[ "$wifi_state" == "enabled" || "$bt_state" -eq 1 ]]; then
        nmcli radio wifi off
        bluetoothctl power off
        echo "✅ Airplane Mode ON"
    else
        nmcli radio wifi on
        bluetoothctl power on
        echo "✅ Airplane Mode OFF"
    fi
}

# --- Menus ---

function global_help() {
    cat <<EOF
Usage: $SCRIPT_NAME SUBSYSTEM ACTION [AMOUNT]

Subsystems:
  bri, brightness     Screen brightness
  kbd, keyboard       Keyboard backlight
  vol, volume         System volume
  mic                 Microphone volume
  wifi                Wi-Fi toggle
  bt                  Bluetooth toggle
  airplane            Airplane mode toggle

Actions:
  -i, --inc           Increase by amount (default: 5%)
  -d, --dec           Decrease by amount (default: 5%)
  -s, --set           Set to exact amount (e.g. 50%)
  --toggle            Toggle on/off/mute state

Examples:
  $SCRIPT_NAME vol --inc 5
  $SCRIPT_NAME vol --set 75
  $SCRIPT_NAME bri -d 10
  $SCRIPT_NAME kbd --set 100
  $SCRIPT_NAME kbd --toggle
EOF
}

# --- Dispatcher ---

case "$subsys" in
    bri|brightness)
        case "$action" in
            --inc|-i) adjust_brightness "+" ;;
            --dec|-d) adjust_brightness "-" ;;
            --set|-s) adjust_brightness "set" ;;
            --toggle) toggle_brightness ;;
            --help|-h) global_help ;;
            *) echo "Invalid brightness action. Use --inc, --dec, --set, or --toggle." >&2; exit 1 ;;
        esac
        ;;
    kbd|keyboard|kbd_backlight)
        case "$action" in
            --inc|-i) adjust_kbd_brightness "+" ;;
            --dec|-d) adjust_kbd_brightness "-" ;;
            --set|-s) adjust_kbd_brightness "set" ;;
            --toggle) toggle_kbd_brightness ;;
            --help|-h) global_help ;;
            *) echo "Invalid keyboard backlight action. Use --inc, --dec, --set, or --toggle." >&2; exit 1 ;;
        esac
        ;;
    vol|volume)
        case "$action" in
            --inc|-i) adjust_volume "@DEFAULT_AUDIO_SINK@" "inc" "1.0" ;;
            --dec|-d) adjust_volume "@DEFAULT_AUDIO_SINK@" "dec" "1.0" ;;
            --set|-s) adjust_volume "@DEFAULT_AUDIO_SINK@" "set" "1.0" ;;
            --toggle) toggle_mute "@DEFAULT_AUDIO_SINK@" ;;
            --help|-h) global_help ;;
            *) echo "Invalid volume action. Use --inc, --dec, --set, or --toggle." >&2; exit 1 ;;
        esac
        ;;
    mic)
        case "$action" in
            --inc|-i) adjust_volume "@DEFAULT_AUDIO_SOURCE@" "inc" "1.0" ;;
            --dec|-d) adjust_volume "@DEFAULT_AUDIO_SOURCE@" "dec" "1.0" ;;
            --set|-s) adjust_volume "@DEFAULT_AUDIO_SOURCE@" "set" "1.0" ;;
            --toggle) toggle_mute "@DEFAULT_AUDIO_SOURCE@" ;;
            *) echo "Invalid mic action. Use --inc, --dec, --set, or --toggle." >&2; exit 1 ;;
        esac
        ;;
    wifi)
        [[ "$action" == "--toggle" ]] && wifi_toggle || global_help
        ;;
    bt)
        [[ "$action" == "--toggle" ]] && bt_toggle || global_help
        ;;
    airplane)
        [[ "$action" == "--toggle" ]] && airplane_toggle || global_help
        ;;
    help|-h|"")
        global_help
        ;;
    *)
        echo "Error: Unknown subsystem '$subsys'." >&2
        global_help
        exit 1
        ;;
esac
