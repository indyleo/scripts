#!/usr/bin/env bash
#
# autoclicker — a simple Wayland/X11 autoclicker built on ydotool
#
# Usage:
#   ./autoclicker.sh                     # left click, 10 clicks/sec, until Ctrl+C
#   ./autoclicker.sh -r 100               # 100ms between clicks (10 CPS)
#   ./autoclicker.sh -b right -r 500       # right-click every 500ms
#   ./autoclicker.sh -c 50                # stop after 50 clicks
#   ./autoclicker.sh -d 5                 # wait 5s before starting (time to position cursor)
#
# Stop anytime with Ctrl+C.

set -euo pipefail

INTERVAL_MS=100      # delay between clicks in ms (100ms = 10 clicks/sec)
BUTTON="left"        # left | right | middle
COUNT=0               # 0 = infinite
START_DELAY=3         # seconds to wait before starting

usage() {
    grep '^#' "$0" | sed 's/^# \{0,1\}//' | sed -n '/Usage:/,/Ctrl+C\./p'
    exit 0
}

while getopts "r:b:c:d:h" opt; do
    case "$opt" in
        r) INTERVAL_MS="$OPTARG" ;;
        b) BUTTON="$OPTARG" ;;
        c) COUNT="$OPTARG" ;;
        d) START_DELAY="$OPTARG" ;;
        h) usage ;;
        *) usage ;;
    esac
done

case "$BUTTON" in
    left)   CODE="0xC0" ;;
    right)  CODE="0xC1" ;;
    middle) CODE="0xC2" ;;
    *) echo "Unknown button '$BUTTON' (use left, right, or middle)"; exit 1 ;;
esac

if ! command -v ydotool >/dev/null 2>&1; then
    echo "ydotool is not installed. Install it first (see comments at top of this script)."
    exit 1
fi

# Quick sanity check that the daemon is reachable.
if ! ydotool click "$CODE" >/dev/null 2>&1; then
    echo "Couldn't reach ydotoold. Make sure the daemon is running:"
    echo "  sudo systemctl enable --now ydotoold"
    echo "or run 'ydotoold &' manually, then try again."
    exit 1
fi

echo "Autoclicker: button=$BUTTON interval=${INTERVAL_MS}ms count=$([ "$COUNT" -eq 0 ] && echo infinite || echo "$COUNT")"
echo "Starting in ${START_DELAY}s — switch to your target window now."
sleep "$START_DELAY"
echo "Clicking... press Ctrl+C to stop."

n=0
while true; do
    ydotool click "$CODE"
    n=$((n + 1))
    if [ "$COUNT" -ne 0 ] && [ "$n" -ge "$COUNT" ]; then
        echo "Done: $n clicks."
        break
    fi
    # sleep supports fractional seconds; convert ms to seconds
    sleep "$(awk "BEGIN {printf \"%.3f\", $INTERVAL_MS/1000}")"
done
